# frpc for one HarmonyOS PC (copy to /data/oh-ssh/frp/frpc-office.toml and fill in).
# boot-start.sh finds frpc by this file name. Each machine needs its own proxy name
# and remote port on the frp server (ohdev: oh-ssh/40822, ohdev2: oh-ssh2/40922).
serverAddr = "FRP_SERVER_HOST"
serverPort = 7777
auth.token = "FRP_TOKEN"
transport.tls.enable = true
log.to = "/data/oh-ssh/frp/frpc.log"
log.level = "info"

[[proxies]]
name = "oh-ssh-MACHINE"
type = "tcp"
localIP = "127.0.0.1"
localPort = 2222
remotePort = REMOTE_PORT
