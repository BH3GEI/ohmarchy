# clang 23 + libc++23 (musl) + OHOS sysroot, for the C++26 Hypr stack.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER   ${HB}/bin/clang)
set(CMAKE_CXX_COMPILER ${HB}/bin/clang++)
set(CMAKE_AR     ${HB}/bin/llvm-ar)
set(CMAKE_RANLIB ${HB}/bin/llvm-ranlib)
set(CMAKE_C_COMPILER_TARGET   aarch64-linux-ohos)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-ohos)
set(CMAKE_SYSROOT ${NDK}/sysroot)

set(_cflags   "-resource-dir=${SP}/stage3/ohos-res")
set(_cxxflags "-nostdinc++ -isystem ${SP}/llvmsrc/build-libcxx/include/c++/v1 -resource-dir=${SP}/stage3/ohos-res")
set(_ldflags  "-B${SP}/stage3/ohos-cxx-lib -L${SP}/stage3/ohos-cxx-lib -L${SP}/stage1/prefix/lib -resource-dir=${SP}/stage3/ohos-res -nostdlib++ -unwindlib=none -lc++_ohm")
set(CMAKE_C_FLAGS_INIT   "${_cflags}")
set(CMAKE_CXX_FLAGS_INIT "${_cxxflags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT    "${_ldflags}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_ldflags}")

set(CMAKE_FIND_ROOT_PATH ${SP}/stage1/prefix)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(ENV{PKG_CONFIG_LIBDIR} "${SP}/stage1/prefix/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "${SP}/stage1/prefix/lib/pkgconfig")
