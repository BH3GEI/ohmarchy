[binaries]
c = '${NDK}/llvm/bin/clang'
cpp = '${NDK}/llvm/bin/clang++'
ar = '${NDK}/llvm/bin/llvm-ar'
strip = '${NDK}/llvm/bin/llvm-strip'
pkg-config = '/opt/homebrew/bin/pkg-config'

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[built-in options]
c_args = ['--target=aarch64-linux-ohos', '-I${SP}/stage1/prefix/include']
c_link_args = ['--target=aarch64-linux-ohos', '-L${SP}/stage1/prefix/lib']
cpp_args = ['--target=aarch64-linux-ohos', '-I${SP}/stage1/prefix/include']
cpp_link_args = ['--target=aarch64-linux-ohos', '-L${SP}/stage1/prefix/lib']

[properties]
needs_exe_wrapper = true
pkg_config_libdir = '${SP}/stage1/prefix/lib/pkgconfig'
