# Arch Linux ARM lives in /arch on deepin's data partition and boots deepin's
# kernel with an initramfs built by Arch's mkinitcpio and the subroot hook.
menuentry "Arch Linux ARM (deepin kernel)" --id arch-deepinkernel {
    search --no-floppy --fs-uuid --set=root @BOOT_UUID@
    linux /boot/vmlinuz-@KVER@ root=UUID=@DATA_UUID@ subroot=arch rw console=tty0 loglevel=4
    initrd /boot/initramfs-deepinkernel.img
}

# Arch Linux ARM's own kernel (linux-aarch64) from /arch/boot. It does not boot
# in 鸿融 yet (kernels >= 6.9 hang before the secondary CPUs start); try it once
# with `grub-editenv /boot/grub/grubenv set next_entry=arch-linux`.
menuentry "Arch Linux ARM (linux-aarch64)" --id arch-linux {
    search --no-floppy --fs-uuid --set=root @DATA_UUID@
    linux /arch/boot/Image root=UUID=@DATA_UUID@ subroot=arch rw console=tty0 loglevel=4
    initrd /arch/boot/initramfs-linux.img
}

# Kernel boot tests (tools/hongrong/hrvm ktest): boots /arch/boot/ktest/${ktest}.Image
# without an initramfs; the result is read from the host's VM log.
menuentry "Kernel test (${ktest})" --id arch-ktest {
    search --no-floppy --fs-uuid --set=root @DATA_UUID@
    linux /arch/boot/ktest/${ktest}.Image console=tty0 earlycon=efifb keep_bootcon ignore_loglevel loglevel=8
}

# Boot Arch by default. deepin's 00_header sets default to next_entry when
# grub-editenv set one, so a one-time choice still wins.
if [ "${default}" = "0" ]; then
    set default="arch-deepinkernel"
fi
