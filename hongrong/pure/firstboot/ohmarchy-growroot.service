[Unit]
Description=Grow the root partition to the whole disk (first boot)
ConditionPathExists=!/var/lib/ohmarchy/growroot.done
After=local-fs.target
Before=display-manager.service getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/lib/ohmarchy/ohmarchy-growroot.sh

[Install]
WantedBy=multi-user.target
