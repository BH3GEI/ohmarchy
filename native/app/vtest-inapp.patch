+#ifdef VTEST_BROKER
+/* Zero-copy frames for GPU clients (VTEST_ZERO_COPY_CLIENTS). A Wayland client on
+ * Mesa virpipe reads each frame back and hands it to the compositor as wl_shm, which
+ * uploads it again: two copies of the whole frame through the CPU. All contexts live
+ * in this one renderer, so instead: when a client reads back a whole resource, copy
+ * it on the GPU into a snapshot resource and write only a tag (magic, snapshot id,
+ * size) into the client's buffer; when the compositor uploads data that starts with
+ * the tag, blit from the snapshot instead. Anything else is left alone. */
+#define ZC_MAGIC 0x5a43484fu /* "OHCZ" */
+#define ZC_MAX 64
+struct zc_snap {
+   int ctx_id;
+   uint32_t src, snap, w, h, format;
+   int compositor_ctx; /* compositor context it is attached to, or 0 */
+};
+static struct zc_snap zc_snaps[ZC_MAX];
+static int zc_count;
+static uint32_t zc_next_handle = 0x7f000000;
+
+static bool zc_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("VTEST_ZERO_COPY_CLIENTS") != NULL;
+   return enabled;
+}
+
+/* VTEST_ZC_TIMING: per-frame stage times, averaged over 120 client frames:
+ * client frame period, client read-back -> compositor upload, upload -> present. */
+static double zc_now_ms(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+}
+static struct { double get, upload, present, sum_period, sum_lat, sum_pres, sum_wake, sum_draw; int n, n_lat, n_pres, n_wake; bool started; double started_at; } zc_t;
+static bool zc_timing(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("VTEST_ZC_TIMING") != NULL;
+   return on;
+}
+static void zc_mark(int stage)
+{
+   double t;
+   if (!zc_timing())
+      return;
+   t = zc_now_ms();
+   if (stage == 0) {
+      if (zc_t.get > 0) {
+         zc_t.sum_period += t - zc_t.get;
+         zc_t.n++;
+      }
+      if (zc_t.started) {
+         zc_t.sum_draw += t - zc_t.started_at;
+      }
+      zc_t.started = false;
+      zc_t.get = t;
+      if (zc_t.n == 120) {
+         fprintf(stderr, "zc timing: client frame %.2f ms, read-back->upload %.2f ms, upload->present %.2f ms, "
+                 "present->client starts drawing %.2f ms, drawing->read-back %.2f ms\n",
+                 zc_t.sum_period / zc_t.n, zc_t.n_lat ? zc_t.sum_lat / zc_t.n_lat : 0,
+                 zc_t.n_pres ? zc_t.sum_pres / zc_t.n_pres : 0, zc_t.n_wake ? zc_t.sum_wake / zc_t.n_wake : 0,
+                 zc_t.n_wake ? zc_t.sum_draw / zc_t.n_wake : 0);
+         memset(&zc_t, 0, sizeof(zc_t));
+         zc_t.get = t;
+      }
+   } else if (stage == 1 && zc_t.get > 0) {
+      zc_t.sum_lat += t - zc_t.get;
+      zc_t.n_lat++;
+      zc_t.upload = t;
+   } else if (stage == 2 && zc_t.upload > 0) {
+      zc_t.sum_pres += t - zc_t.upload;
+      zc_t.n_pres++;
+      zc_t.upload = 0;
+      zc_t.present = t;
+   } else if (stage == 3 && !zc_t.started && zc_t.present > 0) {
+      /* the client's first command after the frame was shown */
+      zc_t.sum_wake += t - zc_t.present;
+      zc_t.n_wake++;
+      zc_t.started = true;
+      zc_t.started_at = t;
+      zc_t.present = 0;
+   }
+}
+
+static bool zc_is_compositor(const struct vtest_context *ctx)
+{
+   return ctx->debug_name && !strcmp(ctx->debug_name, "Hyprland");
+}
+
+static void zc_blit(int ctx_id, uint32_t dst, uint32_t dst_format, const struct virgl_box *d,
+                    uint32_t src, uint32_t src_format, const struct virgl_box *s)
+{
+   uint32_t cmd[VIRGL_CMD_BLIT_SIZE + 1] = {
+      VIRGL_CMD0(VIRGL_CCMD_BLIT, 0, VIRGL_CMD_BLIT_SIZE),
+      VIRGL_CMD_BLIT_S0_MASK(0xf), 0, 0,
+      dst, 0, dst_format, d->x, d->y, 0, d->w, d->h, 1,
+      src, 0, src_format, s->x, s->y, 0, s->w, s->h, 1,
+   };
+   virgl_renderer_submit_cmd(cmd, ctx_id, VIRGL_CMD_BLIT_SIZE + 1);
+}
+
+/* What the snapshot holds: the frame in the byte order the compositor's wl_shm
+ * texture stores (it copies those bytes raw). That is RGBA storage here: zink keeps
+ * BGRA resources as RGBA with a swizzle, so "B8G8R8A8" would land swapped. */
+static uint32_t zc_shm_format(uint32_t format)
+{
+   switch (format) {
+   case VIRGL_FORMAT_B8G8R8X8_UNORM:
+   case VIRGL_FORMAT_R8G8B8X8_UNORM:
+      return VIRGL_FORMAT_R8G8B8X8_UNORM;
+   default:
+      return VIRGL_FORMAT_R8G8B8A8_UNORM;
+   }
+}
+
+/* A client went away (ctx_id) or the renderer was reset (-1): drop its snapshots. */
+static void zc_forget(int ctx_id)
+{
+   for (int i = 0; i < zc_count;) {
+      if (ctx_id < 0 || zc_snaps[i].ctx_id == ctx_id) {
+         if (ctx_id >= 0)
+            virgl_renderer_resource_unref(zc_snaps[i].snap);
+         zc_snaps[i] = zc_snaps[--zc_count];
+      } else {
+         i++;
+      }
+   }
+}
+
+/* Client read-back of a whole resource: snapshot on the GPU, tag the buffer. */
+static bool zc_client_readback(struct vtest_context *ctx, struct vtest_resource *res,
+                               const struct vtest_transfer_args *args)
+{
+   struct virgl_renderer_resource_info info;
+   struct zc_snap *zs = NULL;
+   uint32_t stride, *tag;
+   int i;
+
+   if (!zc_enabled() || zc_is_compositor(ctx) || args->level != 0 || args->box.x || args->box.y ||
+       virgl_renderer_resource_get_info(res->res_id, &info) || info.width != args->box.w ||
+       info.height != args->box.h || info.width < 256 || info.height < 256 || !res->iov.iov_base)
+      return false;
+   stride = args->stride ? args->stride : info.width * 4;
+   if (args->offset + (size_t)stride * (info.height - 1) + 16 > res->iov.iov_len)
+      return false;
+
+   for (i = 0; i < zc_count; i++) {
+      if (zc_snaps[i].src == res->res_id && zc_snaps[i].ctx_id == ctx->ctx_id)
+         zs = &zc_snaps[i];
+   }
+   if (zs && (zs->w != info.width || zs->h != info.height || zs->format != info.virgl_format)) {
+      virgl_renderer_resource_unref(zs->snap);
+      *zs = zc_snaps[--zc_count];
+      zs = NULL;
+   }
+   if (!zs) {
+      struct virgl_renderer_resource_create_args a = {
+         .handle = zc_next_handle++, .target = 2 /* PIPE_TEXTURE_2D */, .format = info.virgl_format,
+         .bind = VIRGL_BIND_SAMPLER_VIEW | VIRGL_BIND_RENDER_TARGET, .width = info.width,
+         .height = info.height, .depth = 1, .array_size = 1,
+      };
+      if (zc_count == ZC_MAX) {
+         virgl_renderer_resource_unref(zc_snaps[0].snap);
+         zc_snaps[0] = zc_snaps[--zc_count];
+      }
+      if (virgl_renderer_resource_create(&a, NULL, 0))
+         return false;
+      zs = &zc_snaps[zc_count++];
+      *zs = (struct zc_snap){ ctx->ctx_id, res->res_id, a.handle, info.width, info.height, a.format, 0 };
+      virgl_renderer_ctx_attach_resource(ctx->ctx_id, zs->snap);
+   }
+   /* a raw copy (cheaper than a blit's draw); colors are the client's order,
+    * Hyprland swaps red and blue when sampling */
+   {
+      uint32_t copy[VIRGL_CMD_RESOURCE_COPY_REGION_SIZE + 1] = {
+         VIRGL_CMD0(VIRGL_CCMD_RESOURCE_COPY_REGION, 0, VIRGL_CMD_RESOURCE_COPY_REGION_SIZE),
+         zs->snap, 0, 0, 0, 0,
+         res->res_id, 0, 0, 0, 0, info.width, info.height, 1,
+      };
+      virgl_renderer_submit_cmd(copy, ctx->ctx_id, VIRGL_CMD_RESOURCE_COPY_REGION_SIZE + 1);
+   }
+
+   zc_mark(0);
+   /* first and last row, whichever way the client copies its rows */
+   tag = (uint32_t *)((char *)res->iov.iov_base + args->offset);
+   tag[0] = ZC_MAGIC; tag[1] = zs->snap; tag[2] = zs->w; tag[3] = zs->h;
+   tag = (uint32_t *)((char *)res->iov.iov_base + args->offset + (size_t)stride * (info.height - 1));
+   tag[0] = ZC_MAGIC; tag[1] = zs->snap; tag[2] = zs->w; tag[3] = zs->h | 0x80000000u;
+   return true;
+}
+
+/* Compositor command buffer: uploads of tagged data become blits from the snapshot.
+ * Returns a new buffer (caller frees) or NULL when nothing changed. */
+static uint32_t *zc_compositor_cmds(struct vtest_context *ctx, const uint32_t *cbuf, uint32_t *len_dw)
+{
+   uint32_t *out = NULL, n = 0, i = 0;
+
+   if (!zc_enabled() || !zc_is_compositor(ctx) || !zc_count)
+      return NULL;
+   while (i < *len_dw) {
+      const uint32_t hdr = cbuf[i], len = hdr >> 16;
+      const uint32_t *c = cbuf + i;
+      struct zc_snap *zs = NULL;
+
+      if ((hdr & 0xff) == VIRGL_CCMD_TRANSFER3D && len == VIRGL_TRANSFER3D_SIZE &&
+          c[VIRGL_TRANSFER3D_DIRECTION] == VIRGL_TRANSFER_TO_HOST) {
+         struct vtest_resource *res = util_hash_table_get(ctx->resource_table, intptr_to_pointer(c[1]));
+         const uint32_t off = c[VIRGL_TRANSFER3D_DATA_OFFSET];
+         if (res && res->iov.iov_base && off + 16 <= res->iov.iov_len) {
+            const uint32_t *tag = (const uint32_t *)((const char *)res->iov.iov_base + off);
+            for (int k = 0; tag[0] == ZC_MAGIC && k < zc_count; k++) {
+               if (zc_snaps[k].snap == tag[1])
+                  zs = &zc_snaps[k];
+            }
+         }
+      }
+      if (zs) {
+         struct virgl_renderer_resource_info sinfo;
+         if (virgl_renderer_resource_get_info(zs->snap, &sinfo))
+            zs = NULL; /* gone: upload the data as sent */
+      }
+      if (zs) {
+         struct virgl_renderer_resource_info dinfo;
+         /* the whole frame (the compositor may upload only the tag row), as raw
+          * bytes: the texture holds wl_shm data as sent and swizzles when sampled */
+         uint32_t copy[VIRGL_CMD_RESOURCE_COPY_REGION_SIZE + 1] = {
+            VIRGL_CMD0(VIRGL_CCMD_RESOURCE_COPY_REGION, 0, VIRGL_CMD_RESOURCE_COPY_REGION_SIZE),
+            c[1], c[2], 0, 0, 0,
+            zs->snap, 0, 0, 0, 0, zs->w, zs->h, 1,
+         };
+         if (!out) {
+            out = malloc((*len_dw + 64) * 4 * 2);
+            memcpy(out, cbuf, i * 4);
+            n = i;
+         }
+         if (zs->compositor_ctx != ctx->ctx_id) {
+            virgl_renderer_ctx_attach_resource(ctx->ctx_id, zs->snap);
+            zs->compositor_ctx = ctx->ctx_id;
+         }
+         memcpy(out + n, copy, sizeof(copy));
+         n += VIRGL_CMD_RESOURCE_COPY_REGION_SIZE + 1;
+         zc_mark(1);
+      } else if (out) {
+         memcpy(out + n, c, (len + 1) * 4);
+         n += len + 1;
+      }
+      i += len + 1;
+   }
+   if (out)
+      *len_dw = n;
+   return out;
+}
+#endif
+
+#ifdef VTEST_BROKER
+/* The compositor's present signal: a blit from its frame into a 7x3 texture (see
+ * Hyprland's signalPresent). Returns the frame's resource, or 0. */
+static uint32_t vtest_present_marker(const struct vtest_context *ctx, const uint32_t *cbuf, uint32_t len_dw)
+{
+   uint32_t frame = 0;
+   if (!ctx->debug_name || strcmp(ctx->debug_name, "Hyprland"))
+      return 0;
+   for (uint32_t i = 0; i < len_dw; i += 1 + (cbuf[i] >> 16)) {
+      struct virgl_renderer_resource_info info;
+      if ((cbuf[i] & 0xff) == VIRGL_CCMD_BLIT && (cbuf[i] >> 16) == VIRGL_CMD_BLIT_SIZE && i + VIRGL_CMD_BLIT_SIZE < len_dw &&
+          !virgl_renderer_resource_get_info(cbuf[i + VIRGL_CMD_BLIT_DST_RES_HANDLE], &info) && info.width == 7 && info.height == 3)
+         frame = cbuf[i + VIRGL_CMD_BLIT_SRC_RES_HANDLE];
+   }
+   return frame;
+}
+#endif
