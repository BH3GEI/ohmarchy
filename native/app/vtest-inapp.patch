+/* In-process server (HarmonyOS app): a root broker owns the listening socket and
+ * passes each accepted client fd over the abstract socket named by
+ * server.socket_name ("@name"). */
+/* Clients the broker bridged from TCP (marker 'r'): served with protocol version 0. */
+static bool vtest_remote_fds[1024];
+
+bool vtest_server_fd_is_remote(int fd)
+{
+   return fd >= 0 && fd < 1024 && vtest_remote_fds[fd];
+}
+
+static int vtest_server_accept(int sock)
+{
+   char byte;
+   char cbuf[CMSG_SPACE(sizeof(int))];
+   struct iovec iov = { &byte, 1 };
+   struct msghdr msg = { 0 };
+   struct cmsghdr *c;
+   int fd = -1;
+
+   msg.msg_iov = &iov;
+   msg.msg_iovlen = 1;
+   msg.msg_control = cbuf;
+   msg.msg_controllen = sizeof(cbuf);
+   if (recvmsg(sock, &msg, MSG_CMSG_CLOEXEC) <= 0)
+      return -1;
+   for (c = CMSG_FIRSTHDR(&msg); c; c = CMSG_NXTHDR(&msg, c)) {
+      if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS)
+         memcpy(&fd, CMSG_DATA(c), sizeof(int));
