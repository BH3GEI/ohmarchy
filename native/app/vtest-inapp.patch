+#ifdef VTEST_BROKER
+/* In-process server (HarmonyOS app): a root broker owns the listening socket and
+ * passes each accepted client fd over the abstract socket named by
+ * server.socket_name ("@name"). */
+static int vtest_server_accept(int sock)
+{
+   char byte;
+   char cbuf[CMSG_SPACE(sizeof(int))];
+   struct iovec iov = { &byte, 1 };
+   struct msghdr msg = { 0 };
+   struct cmsghdr *c;
+   int fd = -1;
+
+   msg.msg_iov = &iov;
+   msg.msg_iovlen = 1;
+   msg.msg_control = cbuf;
+   msg.msg_controllen = sizeof(cbuf);
+   if (recvmsg(sock, &msg, MSG_CMSG_CLOEXEC) <= 0)
+      return -1;
+   for (c = CMSG_FIRSTHDR(&msg); c; c = CMSG_NXTHDR(&msg, c)) {
+      if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS)
+         memcpy(&fd, CMSG_DATA(c), sizeof(int));
+   }
+   return fd;
+}
+
+static void vtest_server_open_socket(void)
+{
+   struct sockaddr_un un;
+   size_t len = strlen(server.socket_name + 1);
+
+   server.socket = socket(PF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   memset(&un, 0, sizeof(un));
+   un.sun_family = AF_UNIX;
+   memcpy(un.sun_path + 1, server.socket_name + 1, len);
+   if (server.socket < 0 ||
+       connect(server.socket, (struct sockaddr *)&un, offsetof(struct sockaddr_un, sun_path) + 1 + len) < 0) {
+      perror("Failed to connect to the broker.");
+      exit(1);
+   }
+}
+#else
+#define vtest_server_accept(sock) accept(sock, NULL, NULL)
