  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "relay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "API relay",
      "options": { "baseURL": "{env:OPENAI_BASE_URL}", "apiKey": "{env:OPENAI_API_KEY}" },
      "models": {
        "kimi/kimi-for-coding": { "name": "Kimi for Coding" },
        "kimi/kimi-for-coding-highspeed": { "name": "Kimi for Coding (high speed)" },
        "kimi/k3.1-pro-highspeed": { "name": "Kimi K3.1 Pro (high speed)" },
        "ark/ark-code-latest": { "name": "Ark Code" }
      }
    }
  },
  "model": "relay/kimi/kimi-for-coding"
}
