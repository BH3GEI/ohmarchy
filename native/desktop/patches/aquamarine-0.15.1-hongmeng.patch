+
+void Aquamarine::CHeadlessBackend::exportFrame(SP<IBuffer> buffer, const CRegion& damage) {
+    const auto attrs = buffer->dmabuf();
+    if (!attrs.success || attrs.fds.at(0) < 0)
+        return;
+
+    struct __attribute__((packed)) {
+        uint32_t magic = 0x4644484f; // "OHDF"
+        uint32_t version = 1;
+        uint64_t bufferId;
+        uint32_t width, height, stride, format, nrects;
+    } hdr;
+    hdr.bufferId = (uint64_t)(uintptr_t)buffer.get();
+    hdr.width    = attrs.size.x;
+    hdr.height   = attrs.size.y;
+    hdr.stride   = attrs.strides.at(0);
+    hdr.format   = attrs.format;
+
+    std::vector<int32_t> rects;
+    damage.copy().intersect(CBox{0, 0, attrs.size.x, attrs.size.y}).forEachRect([&rects](const auto& r) {
+        rects.insert(rects.end(), {r.x1, r.y1, r.x2 - r.x1, r.y2 - r.y1});
+    });
+    const std::vector<int32_t> full = {0, 0, (int32_t)attrs.size.x, (int32_t)attrs.size.y};
+
+    std::erase_if(exportClients, [&](SExportClient& c) {
+        const bool  known   = std::ranges::find(c.sentBuffers, hdr.bufferId) != c.sentBuffers.end();
+        const auto& r       = c.needFull ? full : rects;
+        hdr.nrects          = r.size() / 4;
+
+        iovec iov[2]        = {{&hdr, sizeof(hdr)}, {(void*)r.data(), r.size() * sizeof(int32_t)}};
+        char  cmsgbuf[CMSG_SPACE(sizeof(int))] = {};
+        msghdr msg{.msg_iov = iov, .msg_iovlen = r.empty() ? 1u : 2u};
+        if (!known) {
+            msg.msg_control    = cmsgbuf;
+            msg.msg_controllen = sizeof(cmsgbuf);
+            auto* cmsg         = CMSG_FIRSTHDR(&msg);
+            cmsg->cmsg_level   = SOL_SOCKET;
+            cmsg->cmsg_type    = SCM_RIGHTS;
+            cmsg->cmsg_len     = CMSG_LEN(sizeof(int));
+            memcpy(CMSG_DATA(cmsg), &attrs.fds.at(0), sizeof(int));
+        }
+
+        const ssize_t sent = sendmsg(c.fd.get(), &msg, MSG_DONTWAIT | MSG_NOSIGNAL);
+        if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            c.needFull = true; // client is behind: drop this frame, resend everything next time
+            return false;
+        }
+        if (sent < (ssize_t)(sizeof(hdr) + r.size() * sizeof(int32_t))) {
+            backend->log(AQ_LOG_DEBUG, "headless: export client gone");
+            return true;
+        }
+        if (!known)
+            c.sentBuffers.emplace_back(hdr.bufferId);
+        c.needFull = false;
+        return false;
+    });
+    if (std::ranges::any_of(exportClients, [](const SExportClient& c) { return c.needCursor; }))
+        exportCursor();
 }
 
