+
+void Aquamarine::CHeadlessBackend::exportAccept() {
+    int fd = accept4(exportListenFD.get(), nullptr, nullptr, SOCK_CLOEXEC | SOCK_NONBLOCK);
+    if (fd < 0)
+        return;
+    exportClients.emplace_back(SExportClient{.fd = Hyprutils::OS::CFileDescriptor{fd}});
+    backend->log(AQ_LOG_DEBUG, std::format("headless: export client {} connected", fd));
+
+    // input arrives on the same socket; the fd stays open as long as the client entry does
+    if (exportInputFD.isValid()) {
+        const int rfd = dup(fd), efd = exportInputFD.get();
+        std::thread([this, rfd, efd]() {
+            pollfd p{.fd = rfd, .events = POLLIN};
+            SExportInput ev;
+            size_t       got = 0;
+            while (poll(&p, 1, -1) > 0) {
+                const ssize_t n = recv(rfd, (char*)&ev + got, sizeof(ev) - got, 0);
+                if (n <= 0 && !(n < 0 && (errno == EAGAIN || errno == EINTR)))
+                    break;
+                if (n > 0 && (got += n) == sizeof(ev)) {
+                    got = 0;
+                    {
+                        std::lock_guard lk(exportInputMutex);
+                        exportInputQueue.push_back(ev);
+                    }
+                    const uint64_t one = 1;
+                    write(efd, &one, sizeof(one));
+                }
+            }
+            close(rfd);
+        }).detach();
+    }
+    // the new client needs a full frame now, not at the next damage, and the cursor
+    if (exportLastBuffer)
+        exportFrame(exportLastBuffer, CRegion{0, 0, exportLastBuffer->size.x, exportLastBuffer->size.y});
+    exportCursor();
+}
+
+// The cursor to every export client: a header like a frame's, magic "OHDC", the
+// buffer's geometry (0x0: no cursor) and one "rect" {hotspot x, hotspot y, 0, 0};
+// the buffer's dmabuf comes along the first time, as with frames.
+void Aquamarine::CHeadlessBackend::exportCursor() {
+    struct __attribute__((packed)) {
+        uint32_t magic   = 0x4344484f; // "OHDC"
+        uint32_t version = 1;
+        uint64_t bufferId = 0;
+        uint32_t width = 0, height = 0, stride = 0, format = 0, nrects = 1;
+    } hdr;
+    int32_t rect[4] = {(int32_t)exportCursorHotspot.x, (int32_t)exportCursorHotspot.y, 0, 0};
+    int     fd      = -1;
+    if (exportCursorBuffer && exportCursorVisible) {
+        const auto attrs = exportCursorBuffer->dmabuf();
+        if (attrs.success && attrs.fds.at(0) >= 0) {
+            hdr.bufferId = (uint64_t)(uintptr_t)exportCursorBuffer.get();
+            hdr.width    = attrs.size.x;
+            hdr.height   = attrs.size.y;
+            hdr.stride   = attrs.strides.at(0);
+            hdr.format   = attrs.format;
+            fd           = attrs.fds.at(0);
+        }
+    }
+    std::erase_if(exportClients, [&](SExportClient& c) {
+        const bool known = hdr.bufferId == 0 || std::ranges::find(c.sentBuffers, hdr.bufferId) != c.sentBuffers.end();
+        iovec      iov[2] = {{&hdr, sizeof(hdr)}, {rect, sizeof(rect)}};
+        char       cmsgbuf[CMSG_SPACE(sizeof(int))] = {};
+        msghdr     msg{.msg_iov = iov, .msg_iovlen = 2};
+        if (!known && fd >= 0) {
+            msg.msg_control    = cmsgbuf;
+            msg.msg_controllen = sizeof(cmsgbuf);
+            auto* cmsg         = CMSG_FIRSTHDR(&msg);
+            cmsg->cmsg_level   = SOL_SOCKET;
+            cmsg->cmsg_type    = SCM_RIGHTS;
+            cmsg->cmsg_len     = CMSG_LEN(sizeof(int));
+            memcpy(CMSG_DATA(cmsg), &fd, sizeof(int));
+        }
+        const ssize_t sent = sendmsg(c.fd.get(), &msg, MSG_DONTWAIT | MSG_NOSIGNAL);
+        if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            c.needCursor = true; // client is behind: again after its next frame
+            return false;
+        }
+        if (sent < (ssize_t)(sizeof(hdr) + sizeof(rect)))
+            return true;
+        c.needCursor = false;
+        if (!known)
+            c.sentBuffers.emplace_back(hdr.bufferId);
+        return false;
+    });
+}
+
+bool Aquamarine::CHeadlessOutput::setCursor(SP<IBuffer> buffer, const Hyprutils::Math::Vector2D& hotspot) {
+    if (!backend || !backend->exportListenFD.isValid())
+        return false;
+    backend->exportCursorBuffer  = buffer;
+    backend->exportCursorHotspot = hotspot;
+    backend->exportCursorVisible = true;
+    backend->exportCursor();
+    return true;
+}
+
+void Aquamarine::CHeadlessOutput::moveCursor(const Hyprutils::Math::Vector2D& coord, bool skipSchedule) {
+    ; // the host's pointer is where the input came from already
