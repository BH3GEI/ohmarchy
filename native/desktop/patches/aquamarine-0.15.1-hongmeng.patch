+#pragma once
+
+#include "Allocator.hpp"
+
+namespace Aquamarine {
+    class CDMAHeapAllocator;
+    class CBackend;
+    class CSwapchain;
+
+    // A linear dmabuf from a Linux dma-heap. For systems without a DRM device
+    // (e.g. HarmonyOS' HongMeng kernel), rendered by a software EGL (llvmpipe).
+    class CDMAHeapBuffer : public IBuffer {
+      public:
+        virtual ~CDMAHeapBuffer();
+
+        virtual eBufferCapability                      caps();
+        virtual eBufferType                            type();
+        virtual void                                   update(const Hyprutils::Math::CRegion& damage);
+        virtual bool                                   isSynchronous();
+        virtual bool                                   good();
+        virtual SDMABUFAttrs                           dmabuf();
+        virtual std::tuple<uint8_t*, uint32_t, size_t> beginDataPtr(uint32_t flags);
+        virtual void                                   endDataPtr();
+
+      private:
+        CDMAHeapBuffer(const SAllocatorBufferParams& params, Hyprutils::Memory::CWeakPointer<CDMAHeapAllocator> allocator_,
+                       Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain);
+
+        Hyprutils::Memory::CWeakPointer<CDMAHeapAllocator> allocator;
+
+        size_t                                             bufferLen = 0;
+        uint8_t*                                           data      = nullptr;
+        int                                                fd        = -1;
+
+        SDMABUFAttrs                                       attrs{.success = false};
+
+        friend class CDMAHeapAllocator;
+    };
+
+    class CDMAHeapAllocator : public IAllocator {
+      public:
+        ~CDMAHeapAllocator();
+        // heapPath empty: $AQ_DMA_HEAP, then /dev/dma_heap/system
+        static Hyprutils::Memory::CSharedPointer<CDMAHeapAllocator> create(Hyprutils::Memory::CWeakPointer<CBackend> backend_, const std::string& heapPath = "");
+
+        virtual Hyprutils::Memory::CSharedPointer<IBuffer>          acquire(const SAllocatorBufferParams& params, Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain_);
+        virtual Hyprutils::Memory::CSharedPointer<CBackend>         getBackend();
+        virtual int                                                 drmFD();
+        virtual eAllocatorType                                      type();
+
+        //
+        Hyprutils::Memory::CWeakPointer<CDMAHeapAllocator> self;
+
+      private:
+        CDMAHeapAllocator(int heapFD_, Hyprutils::Memory::CWeakPointer<CBackend> backend_);
+
+        Hyprutils::Memory::CWeakPointer<CBackend> backend;
+        int                                       heapFD = -1;
+
+        friend class CDMAHeapBuffer;
+    };
+};
