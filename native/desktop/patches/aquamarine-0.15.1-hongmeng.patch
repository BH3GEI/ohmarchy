@@ -0,0 +1,163 @@
+#include <aquamarine/allocator/DMAHeap.hpp>
+#include <aquamarine/backend/Backend.hpp>
+#include <aquamarine/allocator/Swapchain.hpp>
+#include "FormatUtils.hpp"
+#include "Shared.hpp"
+#include <fcntl.h>
+#include <unistd.h>
+#include <cstring>
+#include <cstdlib>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-heap.h>
+
+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+#define SP CSharedPointer
+#define WP CWeakPointer
+
+Aquamarine::CDMAHeapBuffer::CDMAHeapBuffer(const SAllocatorBufferParams& params, Hyprutils::Memory::CWeakPointer<CDMAHeapAllocator> allocator_,
+                                           Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain) : allocator(allocator_) {
+    attrs.format = params.format;
+
+    // every format the headless backend offers is 32 bits per pixel
+    const uint32_t stride = ((uint32_t)params.size.x * 4 + 63) & ~63u;
+    bufferLen             = (size_t)stride * (size_t)params.size.y;
+
+    if (allocator->heapFD < 0) {
+        // no dma-heap (an app sandbox): plain shared memory; the compositor's GPU path
+        // presents from GL storage and never looks at these pixels
+        fd = memfd_create("aq-buffer", MFD_CLOEXEC);
+        if (fd < 0 || ftruncate(fd, (off_t)bufferLen) != 0) {
+            allocator->backend->log(AQ_LOG_ERROR, std::format("dma-heap: memfd fallback failed: {}", strerror(errno)));
+            return;
+        }
+    } else {
+        struct dma_heap_allocation_data alloc = {.len = bufferLen, .fd = 0, .fd_flags = O_RDWR | O_CLOEXEC, .heap_flags = 0};
+        if (ioctl(allocator->heapFD, DMA_HEAP_IOCTL_ALLOC, &alloc) < 0) {
+            allocator->backend->log(AQ_LOG_ERROR, std::format("dma-heap: failed to allocate {} bytes: {}", bufferLen, strerror(errno)));
+            return;
+        }
+        fd = (int)alloc.fd;
+    }
+
+    data = (uint8_t*)mmap(nullptr, bufferLen, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        data = nullptr;
+        allocator->backend->log(AQ_LOG_ERROR, std::format("dma-heap: failed to mmap a buffer: {}", strerror(errno)));
+        return;
+    }
+
+    size                = params.size;
+    attrs.size          = params.size;
+    attrs.modifier      = DRM_FORMAT_MOD_LINEAR;
+    attrs.planes        = 1;
+    attrs.strides.at(0) = stride;
+    attrs.fds.at(0)     = fd;
+    attrs.success       = true;
+
+    allocator->backend->log(AQ_LOG_DEBUG, std::format("dma-heap: allocated a buffer with fd {}, size {}, stride {} and format {}", fd, attrs.size, stride, fourccToName(attrs.format)));
+}
+
+Aquamarine::CDMAHeapBuffer::~CDMAHeapBuffer() {
+    events.destroy.emit();
+
+    if (data)
+        munmap(data, bufferLen);
+    if (fd >= 0)
+        close(fd);
+}
+
+eBufferCapability Aquamarine::CDMAHeapBuffer::caps() {
+    return eBufferCapability::BUFFER_CAPABILITY_DATAPTR;
+}
+
+eBufferType Aquamarine::CDMAHeapBuffer::type() {
+    return eBufferType::BUFFER_TYPE_DMABUF;
+}
+
+void Aquamarine::CDMAHeapBuffer::update(const Hyprutils::Math::CRegion& damage) {
+    ; // nothing to do
+}
+
+bool Aquamarine::CDMAHeapBuffer::isSynchronous() {
+    return true;
+}
+
+bool Aquamarine::CDMAHeapBuffer::good() {
+    return attrs.success && data;
+}
+
+SDMABUFAttrs Aquamarine::CDMAHeapBuffer::dmabuf() {
+    return attrs;
+}
+
+std::tuple<uint8_t*, uint32_t, size_t> Aquamarine::CDMAHeapBuffer::beginDataPtr(uint32_t flags) {
+    struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_RW};
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    return {data, attrs.format, bufferLen};
+}
+
+void Aquamarine::CDMAHeapBuffer::endDataPtr() {
+    struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_RW};
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+}
+
+Aquamarine::CDMAHeapAllocator::~CDMAHeapAllocator() {
+    if (heapFD >= 0)
+        close(heapFD);
+}
+
+SP<CDMAHeapAllocator> Aquamarine::CDMAHeapAllocator::create(Hyprutils::Memory::CWeakPointer<CBackend> backend_, const std::string& heapPath) {
+    std::string path = heapPath;
+    if (path.empty()) {
+        const char* env = getenv("AQ_DMA_HEAP");
+        path            = env && *env ? env : "/dev/dma_heap/system";
+    }
+
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0 && heapPath.empty()) {
+        // HarmonyOS's own mode-666 system heap (the chroot sees it as /dev/dma_heap/system;
+        // /dev/dma_heap/* themselves are 0660 for their group, closed to an app)
+        backend_->log(AQ_LOG_DEBUG, std::format("dma-heap: cannot open {}: {}", path, strerror(errno)));
+        path = "/dev/system_heap2";
+        fd   = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    }
+    if (fd < 0) {
+        // no heap at all: buffers come from memfd (AQ_DMA_HEAP=none asks for that directly)
+        backend_->log(AQ_LOG_DEBUG, std::format("dma-heap: cannot open {}: {}; using memfd buffers", path, strerror(errno)));
+        path = "memfd";
+    }
+
+    auto a  = SP<CDMAHeapAllocator>(new CDMAHeapAllocator(fd, backend_));
+    a->self = a;
+
+    backend_->log(AQ_LOG_DEBUG, std::format("dma-heap: created an allocator on {}", path));
+
+    return a;
+}
+
+SP<IBuffer> Aquamarine::CDMAHeapAllocator::acquire(const SAllocatorBufferParams& params, SP<CSwapchain> swapchain_) {
+    auto buf = SP<IBuffer>(new CDMAHeapBuffer(params, self, swapchain_));
+    if (!buf->good())
+        return nullptr;
+    return buf;
+}
+
+SP<CBackend> Aquamarine::CDMAHeapAllocator::getBackend() {
+    return backend.lock();
+}
+
+int Aquamarine::CDMAHeapAllocator::drmFD() {
+    return -1;
+}
+
+eAllocatorType Aquamarine::CDMAHeapAllocator::type() {
+    return eAllocatorType::AQ_ALLOCATOR_TYPE_DMA_HEAP;
+}
+
+Aquamarine::CDMAHeapAllocator::CDMAHeapAllocator(int heapFD_, Hyprutils::Memory::CWeakPointer<CBackend> backend_) : backend(backend_), heapFD(heapFD_) {
+    ; // nothing to do
+}
