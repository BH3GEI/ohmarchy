+
+void Aquamarine::CHeadlessBackend::exportDispatchInput() {
+    uint64_t n;
+    read(exportInputFD.get(), &n, sizeof(n));
+
+    std::vector<SExportInput> events;
+    {
+        std::lock_guard lk(exportInputMutex);
+        events.swap(exportInputQueue);
+    }
+
+    const auto t = nowMs();
+    for (const auto& ev : events) {
+        switch (ev.type) {
+            case 1: { // pointer position in output pixels
+                if (outputs.empty())
+                    break;
+                const auto  output = outputs.front();
+                const auto& mode   = output->state->state().mode ? output->state->state().mode->pixelSize :
+                                                                  (output->state->state().customMode ? output->state->state().customMode->pixelSize : Vector2D{1, 1});
+                exportPointer->events.warp.emit(IPointer::SWarpEvent{
+                    .timeMs = t, .absolute = Vector2D{(double)ev.a / std::max(1.0, mode.x), (double)ev.b / std::max(1.0, mode.y)}, .output = SP<IOutput>(output)});
+                exportPointer->events.frame.emit();
+                break;
+            }
+            case 2: // button (evdev BTN_* code), pressed
+                exportPointer->events.button.emit(IPointer::SButtonEvent{.timeMs = t, .button = (uint32_t)ev.a, .pressed = ev.b != 0});
+                exportPointer->events.frame.emit();
+                break;
+            case 3: // scroll: axis (0 vertical, 1 horizontal), discrete steps
+                exportPointer->events.axis.emit(IPointer::SAxisEvent{.timeMs   = t,
+                                                                     .axis     = ev.a ? IPointer::AQ_POINTER_AXIS_HORIZONTAL : IPointer::AQ_POINTER_AXIS_VERTICAL,
+                                                                     .delta    = 15.0 * ev.b,
+                                                                     .discrete = (double)ev.b});
+                exportPointer->events.frame.emit();
+                break;
+            case 5: // smooth scroll (touchpad): axis, delta in 1/100 px, source 1 = finger
+                exportPointer->events.axis.emit(IPointer::SAxisEvent{.timeMs = t,
+                                                                     .axis   = ev.a ? IPointer::AQ_POINTER_AXIS_HORIZONTAL : IPointer::AQ_POINTER_AXIS_VERTICAL,
+                                                                     .source = ev.c == 1 ? IPointer::AQ_POINTER_AXIS_SOURCE_FINGER : IPointer::AQ_POINTER_AXIS_SOURCE_CONTINUOUS,
+                                                                     .delta  = ev.b / 100.0});
+                exportPointer->events.frame.emit();
+                break;
+            case 6: // scroll stop (fingers lifted): a finger event with delta 0 becomes wl_pointer.axis_stop
+                exportPointer->events.axis.emit(IPointer::SAxisEvent{.timeMs = t,
+                                                                     .axis   = ev.a ? IPointer::AQ_POINTER_AXIS_HORIZONTAL : IPointer::AQ_POINTER_AXIS_VERTICAL,
+                                                                     .source = IPointer::AQ_POINTER_AXIS_SOURCE_FINGER,
+                                                                     .delta  = 0});
+                exportPointer->events.frame.emit();
+                break;
+            case 7: // swipe begin: fingers
+                exportPointer->events.swipeBegin.emit(IPointer::SSwipeBeginEvent{.timeMs = t, .fingers = (uint32_t)ev.a});
+                break;
+            case 8: // swipe update: dx, dy in 1/100 px, fingers
+                exportPointer->events.swipeUpdate.emit(IPointer::SSwipeUpdateEvent{.timeMs = t, .fingers = (uint32_t)ev.c, .delta = {ev.a / 100.0, ev.b / 100.0}});
+                break;
+            case 9: // swipe end: cancelled
+                exportPointer->events.swipeEnd.emit(IPointer::SSwipeEndEvent{.timeMs = t, .cancelled = ev.a != 0});
+                break;
+            case 4: // key (evdev KEY_* code), pressed
+                exportKeyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = t, .key = (uint32_t)ev.a, .pressed = ev.b != 0});
+                break;
+            default: break;
+        }
+    }
 }
 
