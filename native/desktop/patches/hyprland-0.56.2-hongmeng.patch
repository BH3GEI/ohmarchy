+void CGLRenderbuffer::setDamage(const Hyprutils::Math::CRegion& damage) {
+    m_damage = damage;
+}
+
+void CGLRenderbuffer::readBack() {
+    auto buf = m_hlBuffer.lock();
+    if (!buf)
+        return;
+
+    const auto dma               = buf->dmabuf();
+    const auto [data, fmt, size] = buf->beginDataPtr(0);
+    if (!data) {
+        buf->endDataPtr();
+        return;
+    }
+
+    const int  w      = buf->size.x;
+    const int  h      = buf->size.y;
+    const int  stride = dma.strides.at(0) ? dma.strides.at(0) : w * 4;
+    // memory order R,G,B,A matches GL_RGBA; B,G,R,A (XRGB8888/ARGB8888) needs BGRA or a swap
+    const bool rgba = fmt == DRM_FORMAT_XBGR8888 || fmt == DRM_FORMAT_ABGR8888;
+    const bool bgra = !rgba && g_pHyprOpenGL->m_exts.EXT_read_format_bgra;
+
+    static const bool timing = getenv("HYPRLAND_READBACK_TIMING");
+    const auto        t0     = std::chrono::steady_clock::now();
+
+    // Only what was repainted this frame; many small reads cost more than one big one,
+    // so fall back to the whole buffer when the damage covers most of it.
+    std::vector<CBox> boxes;
+    if (m_damage) {
+        CRegion damage = m_damage->copy().intersect(CBox{0, 0, w, h});
+        m_damage.reset();
+        if (damage.empty()) {
+            buf->endDataPtr();
+            return;
+        }
+        double area = 0;
+        damage.forEachRect([&](const auto& r) {
+            boxes.emplace_back(r.x1, r.y1, r.x2 - r.x1, r.y2 - r.y1);
+            area += (double)(r.x2 - r.x1) * (r.y2 - r.y1);
+        });
+        if (area > 0.5 * w * h || boxes.size() > 32)
+            boxes.clear();
+    }
+    if (boxes.empty())
+        boxes.emplace_back(0, 0, w, h);
+
+    double readArea = 0;
+    for (const auto& b : boxes)
+        readArea += b.width * b.height;
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, GLFB(m_framebuffer)->m_fb);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glPixelStorei(GL_PACK_ROW_LENGTH, stride / 4);
+    for (const auto& b : boxes) {
+        const int bx = b.x, by = b.y, bw = b.width, bh = b.height;
+        glReadPixels(bx, by, bw, bh, bgra ? GL_BGRA_EXT : GL_RGBA, GL_UNSIGNED_BYTE, data + (size_t)by * stride + (size_t)bx * 4);
+        if (!rgba && !bgra) {
+            for (int y = by; y < by + bh; y++) {
+                auto* px = rc<uint32_t*>(data + (size_t)y * stride) + bx;
+                for (int x = 0; x < bw; x++)
+                    px[x] = (px[x] & 0xFF00FF00u) | ((px[x] & 0xFFu) << 16) | ((px[x] >> 16) & 0xFFu);
+            }
+        }
+    }
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+
+    buf->endDataPtr();
+
+    if (timing) {
+        static int    n     = 0;
+        static double total = 0;
+        static auto   start = t0;
+        static double area  = 0;
+        area += readArea / ((double)w * h);
+        const auto    now   = std::chrono::steady_clock::now();
+        total += std::chrono::duration<double, std::milli>(now - t0).count();
+        if (++n % 30 == 0) {
+            const double secs = std::chrono::duration<double>(now - start).count();
+            fprintf(stderr, "readback: %.1f ms avg, %.1f frames/s, %.0f%% of the frame read on average over 30 frames (%dx%d)\n", total / 30, 30 / secs,
+                    100 * area / 30, w, h);
+            total = 0;
+            area  = 0;
+            start = now;
+        }
+    }
+}
