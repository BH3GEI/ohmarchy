+// peekPacketSize returns the size of the next packet without consuming it.
+// HongMeng does not report the full length for MSG_TRUNC (it returns the bytes
+// copied, and 0 for a nil buffer, which looked like EOF), so peek into a real
+// buffer and grow it until the packet fits. This works the same on Linux.
+func (s *syncSocket) peekPacketSize() (int, error) {
+	buf := make([]byte, 4096)
+	for {
+		n, _, err := linux.Recvfrom(int(s.f.Fd()), buf, unix.MSG_PEEK)
+		if err != nil {
+			return 0, err
+		}
+		if n < len(buf) {
+			return n, nil
+		}
+		buf = make([]byte, 2*len(buf))
+	}
+}
+
