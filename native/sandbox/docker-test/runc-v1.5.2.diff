diff --git a/vendor/github.com/opencontainers/cgroups/manager/nop_hongmeng.go b/vendor/github.com/opencontainers/cgroups/manager/nop_hongmeng.go
new file mode 100644
index 0000000..02031f6
--- /dev/null
+++ b/vendor/github.com/opencontainers/cgroups/manager/nop_hongmeng.go
@@ -0,0 +1,40 @@
+package manager
+
+// HongMeng (HarmonyOS PC) has no cgroup hierarchy runc can use: one shared
+// hierarchy, v2-style file names, no subsystem names in mountinfo, no devices
+// controller. With OHM_NO_CGROUPS=1 containers get no cgroup at all: no
+// resource limits, no freezer (docker pause), no stats. Test builds only
+// (ohmarchy native sandbox).
+
+import (
+	"errors"
+	"os"
+
+	"github.com/opencontainers/cgroups"
+)
+
+var noCgroups = os.Getenv("OHM_NO_CGROUPS") == "1"
+
+type nopManager struct{ config *cgroups.Cgroup }
+
+var errNoCgroups = errors.New("no cgroups on this system (OHM_NO_CGROUPS=1)")
+
+func (m *nopManager) Apply(int) error                   { return nil }
+func (m *nopManager) AddPid(string, int) error          { return nil }
+func (m *nopManager) GetPids() ([]int, error)           { return nil, nil }
+func (m *nopManager) GetAllPids() ([]int, error)        { return nil, nil }
+func (m *nopManager) GetStats() (*cgroups.Stats, error) { return cgroups.NewStats(), nil }
+func (m *nopManager) Stats(*cgroups.StatsOptions) (*cgroups.Stats, error) {
+	return cgroups.NewStats(), nil
+}
+func (m *nopManager) Freeze(cgroups.FreezerState) error    { return errNoCgroups }
+func (m *nopManager) Destroy() error                       { return nil }
+func (m *nopManager) Path(string) string                   { return "" }
+func (m *nopManager) Set(*cgroups.Resources) error         { return nil }
+func (m *nopManager) GetPaths() map[string]string          { return map[string]string{} }
+func (m *nopManager) GetCgroups() (*cgroups.Cgroup, error) { return m.config, nil }
+func (m *nopManager) GetFreezerState() (cgroups.FreezerState, error) {
+	return cgroups.Undefined, nil
+}
+func (m *nopManager) Exists() bool                  { return true }
+func (m *nopManager) OOMKillCount() (uint64, error) { return 0, nil }
diff --git a/vendor/golang.org/x/sys/unix/uname_hongmeng.go b/vendor/golang.org/x/sys/unix/uname_hongmeng.go
new file mode 100644
index 0000000..f6a7edd
--- /dev/null
+++ b/vendor/golang.org/x/sys/unix/uname_hongmeng.go
@@ -0,0 +1,19 @@
+//go:build linux
+
+package unix
+
+import "bytes"
+
+// Uname as the system call, except that HongMeng's release is reported as the
+// Linux version whose ABI it implements (hongmeng-uname.sh)
+func Uname(buf *Utsname) error {
+	if err := uname(buf); err != nil {
+		return err
+	}
+	if bytes.HasPrefix(buf.Release[:], []byte("HongMeng")) {
+		var r [len(buf.Release)]byte
+		copy(r[:], "6.6.0-hongmeng")
+		buf.Release = r
+	}
+	return nil
+}
