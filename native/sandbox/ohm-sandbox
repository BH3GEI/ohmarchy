#!/system/bin/sh
# ohm-sandbox: Omarchy's Arch Linux locked in its own directory (native route, v1).
# Separate from the demo session (native/arch.sh, /data/local/archtest): its own
# image, mount point, loop device and pid file, so both can run at once.
#   ohm-sandbox create      new image, filled from the demo session's root (read only)
#   ohm-sandbox start       mount the image in private mount/pid/ipc/uts/net namespaces
#   ohm-sandbox stop | status | reset (back to the snapshot taken by create)
#   ohm-sandbox net         connect the network again (after the PC changed networks)
#   ohm-sandbox policy check | validate FILE | show
#                           what policy.conf makes the next start do (policy.sh); is
#                           FILE a valid policy; the policy text (for the settings page)
#   ohm-sandbox snapshot    take the reset snapshot again (stopped)
#   ohm-sandbox run CMD..   run a command inside as root (with the dropped capabilities)
#   ohm-sandbox shell
#   ohm-sandbox build-helpers   rebuild ohime, the sound relay, ohmarchy-desktop, the pty
#                               shim (desktop/hongmeng-ptypeer.c) and the abstract socket
#                               fence (ohm-abstract-fence.c) inside from $S/src
#   ohm-sandbox build-pasta     build pasta inside from its source on stdin (a tar)
#   ohm-sandbox serve | unserve
#                           the helper the app talks to (ohm-sandboxd: only the app's
#                           uid, only start, stop, reset, status)
#   ohm-sandbox desktop start|stop|restart|status
#                           Hyprland inside for the app com.ohmarchy.sandbox: sockets
#                           @ohmsbx-display, -vtest, -audio, -ime (the demo's are ohmarchy-*)
# Inside, the image is the whole filesystem (pivot_root; the host's is detached),
# /dev holds only a few nodes, and every process runs with a bounding set that has
# no mknod, mount (sys_admin), module, raw I/O or MAC capability, so root inside
# cannot bring host devices or filesystems back in.
# The network: the sandbox's init gets a namespace of its own, connected by pasta
# (bin/pasta, passt.top, with passt-hongmeng.patch) on the host. In this build the
# processes inside do not join it (ohm-capdrop --enter joins ipc, uts, pid, mnt): they
# use the host's network. Joining it waits for a door on the host for the app's
# sockets (README: Network). ohm-abstract-fence (preloaded) refuses connects to
# abstract names the sandbox did not bind; an extra layer only (README).
S=${OHM_SANDBOX:-/data/local/ohm-sandbox}
IMG=$S/root.img
CLEAN=$S/clean.img
R=$S/root
PIDF=$S/sandbox.pid
SIZE=64G
DEMO=/data/local/archtest
APP=com.ohmarchy.sandbox
PREFIX=ohmsbx
USER_=builder
# capabilities nothing inside may have, by number (ohm-capdrop.c: setpriv cannot be used,
# HongMeng refuses its PR_SET_KEEPCAPS): mknod 27, sys_admin 21, sys_module 16,
# sys_rawio 17, sys_boot 22, sys_time 25, sys_pacct 20, sys_tty_config 26,
# mac_override 32, mac_admin 33, syslog 34, net_admin 12, audit_control 30,
# audit_read 37, wake_alarm 35, block_suspend 36, linux_immutable 9, bpf 39,
# perfmon 38, checkpoint_restore 40, setpcap 8
DROP=27,21,16,17,22,25,20,26,32,33,34,12,30,37,35,36,9,39,38,40,8
CAPDROP=/usr/local/sbin/ohm-capdrop  # copied into the image at start
# policy.conf (policy.sh): network, shares, capabilities, devices, abstract names;
# read at start, kept for the running sandbox in $S/run (DROP above is the default)
. "$(dirname "$0")/policy.sh"
# the bounding set the running sandbox got at its start
run_drop() { cat "$S/run/drop" 2>/dev/null || echo "$DROP"; }

alive() {
    [ -f "$PIDF" ] && P=$(cat "$PIDF") && [ "$({ cat "/proc/$P/comm"; } 2>/dev/null)" = catatonit ]
}

# a line in the helper's log, with the time
plog() { echo "$(date '+%F %T') $*" | tee -a "$S/sandboxd.log"; }

# Docker inside (policy: docker = on): the kernel docker of native/sandbox/docker-test (/data/local/ohm-docker-test,
# its own mount, pid and net namespaces) puts its socket at /run/docker.sock in here
# through its hook; the hook stops only what it started.
DOCKER_HOOK=/data/local/ohm-docker-test/sandbox-hook.sh

# Secrets never go into the image (README, Secrets): at start they come from the host's
# /data/local/secrets into /run/ohm-secrets in here, a tmpfs gone on stop. The agents'
# configs (setup-ai.sh --out: ai.conf, codex-config.toml, opencode.json; kimi-config.toml
# from ai.conf; the user's)
# and sing-box's (root's); the home has links to them, dangling while it is stopped.
SECRETS=/data/local/secrets
secrets_up() {
    r=/proc/$P/root; d=$r/run/ohm-secrets
    pw=$(grep "^$USER_:" "$r/etc/passwd") || return 0
    u=$(echo "$pw" | cut -d: -f3):$(echo "$pw" | cut -d: -f4)
    mkdir -p "$d" && chown "$u" "$d" && chmod 700 "$d"
    if [ -f "$SECRETS/ai.env" ] && [ -f "$S/lib/setup-ai.sh" ]; then
        cp "$SECRETS/ai.env" "$d/ai.env" && cp "$S/lib/setup-ai.sh" "$d/setup-ai.sh"
        chown "$u" "$d/ai.env" "$d/setup-ai.sh" && chmod 600 "$d/ai.env"
        sh "$0" run /usr/bin/su "$USER_" -c \
            "bash /run/ohm-secrets/setup-ai.sh /run/ohm-secrets/ai.env --out /run/ohm-secrets" > /dev/null 2>&1 \
            || plog "secrets: setup-ai.sh --out failed"
        rm -f "$d/ai.env" "$d/setup-ai.sh"
        # Kimi Code's config takes no variables for the address: written here from ai.conf
        # (the key stays a variable, api_key_env); ~/.kimi-code/config.toml links to it
        sh "$0" run /usr/bin/su "$USER_" -c '. /run/ohm-secrets/ai.conf && umask 077 &&
            printf "%s\n" "default_model = \"relay\"" "" "[providers.relay]" "type = \"anthropic\"" \
                "base_url = \"$ANTHROPIC_BASE_URL\"" "api_key_env = \"ANTHROPIC_AUTH_TOKEN\"" "" \
                "[models.relay]" "provider = \"relay\"" "model = \"$ANTHROPIC_MODEL\"" "max_context_size = 200000" \
                > /run/ohm-secrets/kimi-config.toml' > /dev/null 2>&1 || plog "secrets: kimi config failed"
        # octos's profile (octoscode) holds the relay's address: the image has it with a
        # placeholder (u.json.in), ~/.octos/profiles/u.json links to the filled copy
        sh "$0" run /usr/bin/su "$USER_" -c 'f=$HOME/.octos/profiles/u.json.in; [ -f "$f" ] || exit 0
            . /run/ohm-secrets/ai.conf && umask 077 &&
            sed "s|@OPENAI_BASE_URL@|$OPENAI_BASE_URL|" "$f" > /run/ohm-secrets/octos-u.json' > /dev/null 2>&1 ||
            plog "secrets: octos profile failed"
    fi
    if [ -f "$SECRETS/ohm-sandbox-sing-box.json" ]; then
        cp "$SECRETS/ohm-sandbox-sing-box.json" "$d/sing-box.json" && chmod 600 "$d/sing-box.json"
    fi
}

# end the process in pid file $1 if it still runs binary $2
stop_pidf() {
    p=$(cat "$1" 2>/dev/null) && [ "$(readlink "/proc/$p/exe" 2>/dev/null)" = "$2" ] && kill "$p"
    rm -f "$1"
}

net_up() {
    # HarmonyOS keeps the default route in a table of its own (policy routing)
    set -- $(ip route show table all 2>/dev/null | grep -m1 '^default via ')
    [ "$1" = default ] && [ "$4" = dev ] || { echo "network: no default route; offline"; return 0; }
    # pasta drops capabilities before it opens the namespace, and /proc/<pid>/ns/net is
    # then out of its reach: a bind mount of it, until pasta holds it open
    F=$S/run/netns; mkdir -p "$S/run"; : > "$F"
    mount --bind "/proc/$P/ns/net" "$F" || return 1
    "$S/bin/pasta" --runas 0 --netns "$F" --netns-only --config-net -4 -i "$5" -g "$3" \
        -t none -u none -T none -U none --no-map-gw -q -P "$S/pasta.pid" -l "$S/pasta.log" > /dev/null 2>&1
    rc=$?
    umount -l "$F"; rm -f "$F"
    [ $rc = 0 ] && echo "network: through $5 ($3)" || echo "network: pasta failed ($S/pasta.log)"
}

# our image on a loop device already (losetup -a lists only /dev/loopN; ask each)
attached() {
    for d in /dev/block/loop*; do
        losetup "$d" 2>/dev/null | grep -qF "($IMG)" && return 0
    done
    return 1
}

# GNU tar/cp from the demo root, run on the host (toybox has no sparse cp, and its tar
# maps owners through the host's passwd)
gnu() {
    D=$(cat "$DEMO/session.pid" 2>/dev/null); L=/proc/$D/root/usr/lib
    [ -x "$L/ld-linux-aarch64.so.1" ] || { echo "the demo session is not running (needed for $1)" >&2; return 1; }
    t=$1; shift
    "$L/ld-linux-aarch64.so.1" --library-path "$L" "/proc/$D/root/usr/bin/$t" "$@"
}

case "$1" in
create)
    [ -e "$IMG" ] && { echo "refusing: $IMG exists"; exit 1; }
    D=$(cat "$DEMO/session.pid" 2>/dev/null)
    [ -d "/proc/$D/root/usr" ] || { echo "the demo session is not running"; exit 1; }
    mkdir -p "$R"
    truncate -s "$SIZE" "$IMG" && mke2fs -t ext4 -q -F "$IMG" || exit 1
    # copy in a private mount namespace; build trees and caches stay out
    unshare -m sh -c '
        n=0; until losetup /dev/block/loop$n "$1" 2>/dev/null; do n=$((n+1)); [ -b /dev/block/loop$n ] || exit 1; done
        mount -t ext4 /dev/block/loop$n "$2" || exit 1
        L=/proc/$3/root/usr/lib; T="$L/ld-linux-aarch64.so.1 --library-path $L /proc/$3/root/usr/bin/tar"
        $T -C /proc/$3/root --one-file-system --numeric-owner --xattrs --acls -cpf - \
            --exclude=./home/builder/hmvk --exclude=./home/builder/pkg --exclude=./home/hmvbuild \
            --exclude=./home/builder/.cache --exclude="./var/cache/pacman/pkg/*" --exclude="./var/tmp/*" \
            --exclude="./tmp/*" --exclude="./run/*" . |
            $T -C "$2" --numeric-owner --xattrs --acls -xpf -
        echo "copy exit $?"; df -h "$2" | tail -1
        umount "$2"; losetup -d /dev/block/loop$n
    ' sh "$IMG" "$R" "$D"
    gnu cp --sparse=always "$IMG" "$CLEAN" && echo "snapshot: $CLEAN"
    ;;
start)
    if alive; then echo "already running: $P"; exit 0; fi
    [ -f "$IMG" ] || { echo "no image: ohm-sandbox create"; exit 1; }
    # Only real conflicts refuse: the demo has its own image, directory and loop device,
    # and without the app nothing in here listens on a socket.
    attached && { echo "refusing: $IMG is attached to a loop already"; exit 1; }
    rm -f "$PIDF"
    policy_load
    policy_log
    mkdir -p "$S/run"
    policy_drop > "$S/run/drop"
    policy_summary > "$S/run/policy.effective"
    netns=-n; [ "$POL_NET" = host ] && netns=
    POL_DROP=$(policy_drop) POL_SHARES="$POL_SHARES" POL_DEV="$POL_DEV" POL_ALLOW="$POL_ALLOW" \
        nohup unshare -m -p -i -u $netns -f sh "$0" _session < /dev/null > "$S/sandbox.log" 2>&1 &
    i=0; while [ $i -lt 30 ] && ! alive; do sleep 1; i=$((i+1)); done
    alive && echo "started: $P" || { echo "failed to start"; cat "$S/sandbox.log"; exit 1; }
    case "$POL_NET" in
    pasta) net_up;;
    off) echo "network: off (policy)";;
    host) echo "network: the host's (policy: network = host)";;
    esac
    if [ "$POL_DOCKER" = on ]; then
        if [ -f "$DOCKER_HOOK" ]; then
            setsid sh "$DOCKER_HOOK" start "$P" < /dev/null > "$S/docker-hook.log" 2>&1 &
            echo "docker: starting (policy: docker = on)"
        else
            plog "docker skipped: no $DOCKER_HOOK"
        fi
    fi
    secrets_up
    # The proxy (README, Proxy): sing-box in here on 127.0.0.1:7890 when there is a config
    # in the secrets and nothing listens there yet (the processes in here share the
    # host's network, so that port is the host's). It ends with the pid namespace on stop.
    if [ -f "/proc/$P/root/run/ohm-secrets/sing-box.json" ] && ! netstat -tln 2>/dev/null | grep -q ' 127\.0\.0\.1:7890 '; then
        # detached in here too: started by the helper (the app's start), a plain & died with it
        setsid sh "$0" run /bin/sh -c 'nohup setsid sing-box run -c /run/ohm-secrets/sing-box.json > /var/log/ohmarchy-sing-box.log 2>&1 < /dev/null &
            echo $! > /run/ohmarchy-sing-box.pid' < /dev/null > /dev/null 2>&1
        echo "proxy: sing-box on 127.0.0.1:7890"
    fi
    ;;
policy)
    case "$2" in
    check) policy_check;;
    # the helper's writepolicy: is FILE a policy this parser takes? (read only)
    validate) [ -f "$3" ] || { echo "no file"; exit 2; }
        r=$(pol_parse "$3") && echo ok || { echo "$r"; exit 1; };;
    # the policy as the settings page reads it: the file, or the defaults
    show) cat "$S/policy.conf" 2>/dev/null || cat "$S/policy.conf.default" 2>/dev/null || echo "network = pasta";;
    *) echo "usage: ohm-sandbox policy check | validate FILE | show"; exit 2;;
    esac
    ;;
secrets)  # refill /run/ohm-secrets (after /data/local/secrets changed); prints no secret
    alive || { echo "not running"; exit 1; }
    secrets_up
    ls "/proc/$P/root/run/ohm-secrets"
    ;;
net)
    alive || { echo "not running"; exit 1; }
    grep -q '^net=pasta ' "$S/run/policy.effective" 2>/dev/null || { echo "network is not pasta (policy)"; exit 1; }
    stop_pidf "$S/pasta.pid" "$S/bin/passt"
    net_up
    ;;
_session)
    set -e
    mount --make-rprivate / 2>/dev/null || true
    n=0
    until losetup "/dev/block/loop$n" "$IMG" 2>/dev/null; do
        n=$((n+1)); [ -b "/dev/block/loop$n" ] || { echo "no free loop device"; exit 1; }
    done
    echo "/dev/block/loop$n" > "$S/sandbox.loop"
    # a failure before pivot_root: unmount and free the loop, so start can be retried
    trap 'cd /; umount -l "$R" 2>/dev/null; losetup -d "/dev/block/loop$n" 2>/dev/null; rm -f "$S/sandbox.loop"' EXIT
    mount -t ext4 -o nodev "/dev/block/loop$n" "$R"
    ip link set lo up || echo "loopback not up"
    # host folders the policy shares (checked by policy.sh): nosuid, nodev; a read-only
    # one that cannot be made read-only is left out, never shared writable
    printf '%s' "$POL_SHARES" | while read -r h i m; do
        [ -n "$h" ] || continue
        mkdir -p "$R$i" && mount -o bind "$h" "$R$i" || { plog "share skipped: $h -> $i (bind failed)"; continue; }
        o=remount,bind,nosuid,nodev; [ "$m" = ro ] && o=$o,ro
        if mount -o "$o" "$R$i" 2>/dev/null && { [ "$m" = rw ] || ! touch "$R$i/.ohm-ro-test" 2>/dev/null; }; then
            plog "share: $h -> $i $m"
        else
            rm -f "$R$i/.ohm-ro-test" 2>/dev/null
            umount "$R$i"; plog "share skipped: $h -> $i $m (could not be made $m)"
        fi
    done
    mount -t proc -o nosuid,nodev,noexec proc "$R/proc"
    # the kernel's knobs stay read-only (no sys_admin inside to remount them)
    mount -o bind "$R/proc/sys" "$R/proc/sys"; mount -o remount,bind,ro "$R/proc/sys"
    mount -o bind /dev/null "$R/proc/sysrq-trigger" 2>/dev/null || true
    # sysfs read-only: HongMeng refuses a read-only remount of a bind (ENOTSUP), so a
    # fresh read-only sysfs; without one, /sys stays empty rather than writable
    mount -t sysfs -o ro,nosuid,nodev,noexec sysfs "$R/sys" || echo "no read-only sysfs: /sys left empty"
    mount -t tmpfs -o mode=755,nosuid tmpfs "$R/dev"
    for d in "null 1 3" "zero 1 5" "full 1 7" "random 1 8" "urandom 1 9" "tty 5 0" "ptmx 5 2"; do
        set -- $d; mknod "$R/dev/$1" c "$2" "$3"; chmod 666 "$R/dev/$1"
    done
    mkdir -p "$R/dev/pts" "$R/dev/shm"
    mount -t devpts -o newinstance,ptmxmode=0666 devpts "$R/dev/pts" 2>/dev/null || true
    mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$R/dev/shm"
    if [ -c /dev/system_heap2 ]; then  # the desktop's buffers; numbers differ per machine
        mkdir -p "$R/dev/dma_heap"
        set -- $(stat -c '%t %T' /dev/system_heap2)
        mknod "$R/dev/dma_heap/system" c $((0x$1)) $((0x$2)); chmod 666 "$R/dev/dma_heap/system"
    fi
    for d in $POL_DEV; do  # extra nodes the policy allows, numbers from the host's
        [ -c "/dev/$d" ] || { plog "dev skipped: $d (not on the host)"; continue; }
        mkdir -p "$(dirname "$R/dev/$d")"
        set -- $(stat -c '%t %T' "/dev/$d")
        mknod "$R/dev/$d" c $((0x$1)) $((0x$2)); chmod 666 "$R/dev/$d"
    done
    ln -sf /proc/self/fd "$R/dev/fd"
    ln -sf /proc/self/fd/0 "$R/dev/stdin"; ln -sf /proc/self/fd/1 "$R/dev/stdout"; ln -sf /proc/self/fd/2 "$R/dev/stderr"
    mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$R/tmp"
    mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$R/run"
    # abstract names bound inside, for ohm-abstract-fence: anyone may add, none list
    mkdir -m 1733 "$R/run/ohm-abstract"
    # docker's socket, when the policy has docker on (the hook puts it there)
    printf '%s\n' '[ -S /run/docker.sock ] && export DOCKER_HOST=unix:///run/docker.sock' > "$R/etc/profile.d/ohm-docker.sh"
    # host names the policy lets programs connect to besides those (abstract_allow)
    printf '%s\n' $POL_ALLOW > "$R/run/ohm-abstract-allow"; chmod 644 "$R/run/ohm-abstract-allow"
    mkdir -p "$R/usr/local/sbin" && cp "$S/bin/ohm-capdrop" "$R$CAPDROP" && chmod 755 "$R$CAPDROP"
    trap - EXIT
    cut -d' ' -f4 /proc/self/stat > "$PIDF"   # host pid of this shell (host procfs still)
    # the image becomes /; the host's filesystem is detached from this namespace
    mkdir -p "$R/.oldroot"
    cd "$R"
    pivot_root . .oldroot
    cd /
    /usr/bin/umount -l /.oldroot
    /usr/bin/rmdir /.oldroot
    set +e
    echo "sandbox up on /dev/block/loop$n"
    # no host file stays open in here: init's stdio goes to the sandbox's own /dev/null
    exec "$CAPDROP" "${POL_DROP:-$DROP}" -- /usr/bin/env -i /usr/bin/catatonit -P < /dev/null > /dev/null 2>&1
    ;;
run|shell)
    alive || { echo "not running"; exit 1; }
    c=$1; shift
    [ "$c" = shell ] && set -- /usr/bin/bash -l
    # ohm-capdrop joins the namespaces (the mount one last: it moves the process to the
    # image's root), drops the capabilities and runs the command in a child
    exec "$S/bin/ohm-capdrop" --enter "$P" "$(run_drop)" -- /usr/bin/env -i HOME=/root TERM=xterm-256color \
        LANG=C.UTF-8 PATH=/usr/local/sbin:/usr/local/bin:/usr/bin "$@"
    ;;
status)
    alive && echo "running: $P ($(cat "$S/sandbox.loop" 2>/dev/null))" || echo "stopped"
    ;;
build-helpers)
    alive || { echo "not running"; exit 1; }
    # sources go in on stdin; nothing of the host is mounted inside
    tar -C "$S/src" -cf - ohime.c ohmarchy-audio-relay.c ohmarchy-desktop input-method-unstable-v2.xml \
        hongmeng-ptypeer.c ohm-abstract-fence.c ohm-fence-demo |
        sh "$0" run /usr/bin/bash -c '
set -e; d=/root/ohm-src; rm -rf $d; mkdir -p $d; tar -C $d -xf -; cd $d
wayland-scanner client-header input-method-unstable-v2.xml input-method-unstable-v2-client-protocol.h
wayland-scanner private-code input-method-unstable-v2.xml input-method-unstable-v2-protocol.c
gcc -O2 -o /opt/ohmarchy/bin/ohime ohime.c input-method-unstable-v2-protocol.c -I. -lwayland-client
cc -O2 -o /opt/ohmarchy/bin/ohmarchy-audio-relay ohmarchy-audio-relay.c
install -m 755 ohmarchy-desktop /opt/ohmarchy/bin/ohmarchy-desktop
# ptys: no slave nodes in here (the host keeps them); open the slave through the master
gcc -O2 -shared -fPIC -o /usr/local/lib/libhongmeng-ptypeer.so hongmeng-ptypeer.c -ldl
grep -q libhongmeng-ptypeer /etc/ld.so.preload || echo /usr/local/lib/libhongmeng-ptypeer.so >> /etc/ld.so.preload
# abstract socket names of the host stay out of reach of programs going through libc
gcc -O2 -shared -fPIC -o /usr/local/lib/libohm-abstract-fence.so ohm-abstract-fence.c -ldl
grep -q libohm-abstract-fence /etc/ld.so.preload || echo /usr/local/lib/libohm-abstract-fence.so >> /etc/ld.so.preload
install -m 755 ohm-fence-demo /usr/local/bin/ohm-fence-demo
# sudo opens a pty of its own for the command (use_pty) and finds no /dev/pts node in
# here: it runs the command on the terminal it was started from instead
printf "Defaults !use_pty\n" > /etc/sudoers.d/ohm-no-pty
chmod 440 /etc/sudoers.d/ohm-no-pty
visudo -c -q
echo "helpers built"'
    ;;
build-pasta)
    alive || { echo "not running"; exit 1; }
    sh "$0" run /usr/bin/bash -c 'set -e; d=/root/passt-src; rm -rf $d; mkdir -p $d; tar -C $d -xf -
cd $d; make -s static > build.log 2>&1 || { tail -20 build.log >&2; exit 1; }; cat passt' > "$S/bin/passt.new" &&
        chmod 755 "$S/bin/passt.new" && mv "$S/bin/passt.new" "$S/bin/passt" && ln -sf passt "$S/bin/pasta" &&
        echo "pasta built" || { rm -f "$S/bin/passt.new"; echo "pasta build failed"; exit 1; }
    ;;
desktop)
    c=${2:-start}
    if [ "$c" = restart ]; then sh "$0" desktop stop > /dev/null 2>&1; exec sh "$0" desktop start; fi
    if [ "$c" = status ]; then
        alive && sh "$0" run /usr/bin/pgrep -x Hyprland > /dev/null && echo running || echo stopped
        exit 0
    fi
    if [ "$c" = start ]; then sh "$0" start > /dev/null || exit 1; fi
    alive || { echo "not running"; exit 1; }
    pw=$(grep "^$USER_:" "/proc/$P/root/etc/passwd") || { echo "no user $USER_"; exit 1; }
    uid=$(echo "$pw" | cut -d: -f3); gid=$(echo "$pw" | cut -d: -f4); home=$(echo "$pw" | cut -d: -f6)
    app_uid=$(bm dump -n "$APP" 2>/dev/null | grep -m1 '"uid"' | tr -dc 0-9)
    # bm answers nothing in init's context (the helper started at boot): the owner of
    # the app's data, as serve does. Without it there is no sound (no audio relay).
    [ -n "$app_uid" ] || app_uid=$(stat -c %u "/data/app/el1/100/base/$APP" 2>/dev/null)
    if [ "$c" = start ]; then
        sh "$0" run /opt/ohmarchy/bin/ohmarchy-sysbus start > /dev/null 2>&1
        # The GPU broker belongs to the helper: it runs on the host, binds the desktop's
        # vtest socket into the sandbox through /proc/<init>/root and hands the
        # desktop's GPU connections to the app (only $APP's uid). The app starts and
        # stops the desktop through ohm-sandboxd, so no restart hook here.
        sock=/proc/$P/root/tmp/.virgl_test
        if ! { [ -f "$S/broker.pid" ] && kill -0 "$(cat "$S/broker.pid")" 2>/dev/null; }; then
            rm -f "$sock"
            setsid "$S/bin/vtest-broker" ${app_uid:+--app-uid "$app_uid"} \
                --user "$uid:$gid" "$sock" "$PREFIX-vtest" < /dev/null > "$S/broker.log" 2>&1 &
            echo $! > "$S/broker.pid"
            i=0; while [ $i -lt 30 ] && [ ! -S "$sock" ]; do sleep 0.1; i=$((i+1)); done
            chmod 666 "$sock"
        fi
    fi
    # the desktop runs as the user, with the sandbox's socket names
    exec "$S/bin/ohm-capdrop" --enter "$P" "$(run_drop)" -- /usr/bin/env -i HOME="$home" USER="$USER_" \
        LOGNAME="$USER_" SHELL=/bin/bash LANG=en_US.UTF-8 XDG_RUNTIME_DIR="/run/user/$uid" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/bin OHMARCHY_SOCKET_PREFIX="$PREFIX" \
        ${app_uid:+OHMARCHY_APP_UID="$app_uid"} HYPRLAND_SURFACELESS_GALLIUM_DRIVER=virpipe \
        HYPRLAND_READBACK_PRESENT=1 /usr/bin/bash -c '
install -d -m 700 -o "$1" -g "$2" "$XDG_RUNTIME_DIR"
cd "$HOME" 2>/dev/null || cd /
exec /usr/bin/chroot --skip-chdir --userspec="$1:$2" --groups="$(id -G "$3" | tr " " ,)" / \
    /usr/bin/bash -lc "/opt/ohmarchy/bin/ohmarchy-desktop $4" < /dev/null > /dev/null 2>&1' \
        ohm "$uid" "$gid" "$USER_" "$c"
    ;;
stop)
    alive || { echo "not running"; exit 0; }
    # the broker forks a child per role: end every process running our broker binary
    # (the demo's runs from its own directory, so it is never matched)
    for d in /proc/[0-9]*; do
        [ "$(readlink "$d/exe" 2>/dev/null)" = "$S/bin/vtest-broker" ] && kill "${d#/proc/}" 2>/dev/null
    done
    rm -f "$S/broker.pid"
    stop_pidf "$S/pasta.pid" "$S/bin/passt"
    if [ -f "$DOCKER_HOOK" ] && grep -q ' docker=on ' "$S/run/policy.effective" 2>/dev/null; then
        # the hook stops what it started; at most 10 s
        sh "$DOCKER_HOOK" stop >> "$S/docker-hook.log" 2>&1 &
        h=$!; i=0
        while [ $i -lt 10 ] && kill -0 $h 2>/dev/null; do sleep 1; i=$((i+1)); done
        kill $h 2>/dev/null
    fi
    nsenter -t "$P" -m sync
    kill -9 "$P"   # pid-namespace init: SIGKILL tears the namespace down
    i=0; while [ $i -lt 20 ] && [ -d "/proc/$P" ]; do sleep 1; i=$((i+1)); done
    rm -f "$PIDF"
    L=$(cat "$S/sandbox.loop" 2>/dev/null)
    i=0
    while [ -n "$L" ] && [ $i -lt 20 ] && losetup "$L" 2>/dev/null | grep -qF "($IMG)"; do
        losetup -d "$L" 2>/dev/null || sleep 0.5
        i=$((i+1))
    done
    rm -f "$S/sandbox.loop"
    echo stopped
    ;;
serve)
    for d in /proc/[0-9]*; do
        [ "$(readlink "$d/exe" 2>/dev/null)" = "$S/bin/ohm-sandboxd" ] && { echo "serving: ${d#/proc/}"; exit 0; }
    done
    app_uid=$(bm dump -n "$APP" 2>/dev/null | grep -m1 '"uid"' | tr -dc 0-9)
    # started by init at boot, bm gets no answer (no access token for the bundle
    # manager): the owner of the app's el1 directory, there from boot, is its uid
    [ -n "$app_uid" ] || app_uid=$(stat -c %u "/data/app/el1/100/base/$APP" 2>/dev/null)
    [ "${app_uid:-0}" -ge 10000 ] 2>/dev/null || { echo "$APP is not installed"; exit 1; }
    cd /
    setsid "$S/bin/ohm-sandboxd" --app-uid "$app_uid" --launcher "$S/bin/ohm-sandbox" --name "$PREFIX-ctl" \
        < /dev/null >> "$S/sandboxd.log" 2>&1 &
    echo "serving for $APP (uid $app_uid): @$PREFIX-ctl"
    ;;
unserve)
    for d in /proc/[0-9]*; do
        [ "$(readlink "$d/exe" 2>/dev/null)" = "$S/bin/ohm-sandboxd" ] && kill "${d#/proc/}"
    done
    echo "not serving"
    ;;
reset)
    alive && { echo "running: stop it first"; exit 1; }
    [ -f "$CLEAN" ] || { echo "no snapshot $CLEAN"; exit 1; }
    # the copy needs the snapshot's used size (~14 GB) free; keep a wide margin
    free=$(df -k "$S" | awk 'NR==2 {print int($4 / 1048576)}')
    [ "$free" -ge 50 ] || { echo "refusing: only ${free} GB free on $(df "$S" | awk 'NR==2 {print $6}')"; exit 1; }
    # low priority, so a running demo desktop is not slowed down
    lo="nice -n 19"; command -v ionice > /dev/null && lo="$lo ionice -c 3"
    $lo sh "$0" _copy "$CLEAN" "$IMG.new" && mv "$IMG.new" "$IMG" && echo "reset to the snapshot"
    ;;
_copy)
    gnu cp --sparse=always "$2" "$3"
    ;;
snapshot)
    alive && { echo "running: stop it first"; exit 1; }
    lo="nice -n 19"; command -v ionice > /dev/null && lo="$lo ionice -c 3"
    $lo sh "$0" _copy "$IMG" "$CLEAN.new" && mv "$CLEAN.new" "$CLEAN" && echo "snapshot: $CLEAN"
    ;;
*)
    echo "usage: ohm-sandbox create|start|stop|status|reset|run CMD..|shell" >&2; exit 2 ;;
esac
