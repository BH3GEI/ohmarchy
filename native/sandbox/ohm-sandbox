#!/system/bin/sh
# ohm-sandbox: Omarchy's Arch Linux locked in its own directory (native route, v1).
# Separate from the demo session (native/arch.sh, /data/local/archtest): its own
# image, mount point, loop device and pid file, so both can run at once.
#   ohm-sandbox create      new image, filled from the demo session's root (read only)
#   ohm-sandbox start       mount the image in private mount/pid/ipc/uts namespaces
#   ohm-sandbox stop | status | reset (back to the snapshot taken by create)
#   ohm-sandbox run CMD..   run a command inside as root (with the dropped capabilities)
#   ohm-sandbox shell
#   ohm-sandbox build-helpers   rebuild ohime, the sound relay, ohmarchy-desktop and the pty
#                               shim (desktop/hongmeng-ptypeer.c) inside
#                               from $S/src (they carry the sandbox's socket names)
#   ohm-sandbox desktop start|stop|restart|status
#                           Hyprland inside for the app com.ohmarchy.sandbox: sockets
#                           @ohmsbx-display, -vtest, -audio, -ime (the demo's are ohmarchy-*)
# Inside, the image is the whole filesystem (pivot_root; the host's is detached),
# /dev holds only a few nodes, and every process runs with a bounding set that has
# no mknod, mount (sys_admin), module, raw I/O or MAC capability, so root inside
# cannot bring host devices or filesystems back in.
S=${OHM_SANDBOX:-/data/local/ohm-sandbox}
IMG=$S/root.img
CLEAN=$S/clean.img
R=$S/root
PIDF=$S/sandbox.pid
SIZE=64G
DEMO=/data/local/archtest
APP=com.ohmarchy.sandbox
PREFIX=ohmsbx
USER_=builder
# capabilities nothing inside may have, by number (ohm-capdrop.c: setpriv cannot be used,
# HongMeng refuses its PR_SET_KEEPCAPS): mknod 27, sys_admin 21, sys_module 16,
# sys_rawio 17, sys_boot 22, sys_time 25, sys_pacct 20, sys_tty_config 26,
# mac_override 32, mac_admin 33, syslog 34, net_admin 12, audit_control 30,
# audit_read 37, wake_alarm 35, block_suspend 36, linux_immutable 9, bpf 39,
# perfmon 38, checkpoint_restore 40, setpcap 8
DROP=27,21,16,17,22,25,20,26,32,33,34,12,30,37,35,36,9,39,38,40,8
CAPDROP=/usr/local/sbin/ohm-capdrop  # copied into the image at start

alive() {
    [ -f "$PIDF" ] && P=$(cat "$PIDF") && [ "$({ cat "/proc/$P/comm"; } 2>/dev/null)" = catatonit ]
}

# our image on a loop device already (losetup -a lists only /dev/loopN; ask each)
attached() {
    for d in /dev/block/loop*; do
        losetup "$d" 2>/dev/null | grep -qF "($IMG)" && return 0
    done
    return 1
}

# GNU tar/cp from the demo root, run on the host (toybox has no sparse cp, and its tar
# maps owners through the host's passwd)
gnu() {
    D=$(cat "$DEMO/session.pid" 2>/dev/null); L=/proc/$D/root/usr/lib
    [ -x "$L/ld-linux-aarch64.so.1" ] || { echo "the demo session is not running (needed for $1)" >&2; return 1; }
    t=$1; shift
    "$L/ld-linux-aarch64.so.1" --library-path "$L" "/proc/$D/root/usr/bin/$t" "$@"
}

case "$1" in
create)
    [ -e "$IMG" ] && { echo "refusing: $IMG exists"; exit 1; }
    D=$(cat "$DEMO/session.pid" 2>/dev/null)
    [ -d "/proc/$D/root/usr" ] || { echo "the demo session is not running"; exit 1; }
    mkdir -p "$R"
    truncate -s "$SIZE" "$IMG" && mke2fs -t ext4 -q -F "$IMG" || exit 1
    # copy in a private mount namespace; build trees and caches stay out
    unshare -m sh -c '
        n=0; until losetup /dev/block/loop$n "$1" 2>/dev/null; do n=$((n+1)); [ -b /dev/block/loop$n ] || exit 1; done
        mount -t ext4 /dev/block/loop$n "$2" || exit 1
        L=/proc/$3/root/usr/lib; T="$L/ld-linux-aarch64.so.1 --library-path $L /proc/$3/root/usr/bin/tar"
        $T -C /proc/$3/root --one-file-system --numeric-owner --xattrs --acls -cpf - \
            --exclude=./home/builder/hmvk --exclude=./home/builder/pkg --exclude=./home/hmvbuild \
            --exclude=./home/builder/.cache --exclude="./var/cache/pacman/pkg/*" --exclude="./var/tmp/*" \
            --exclude="./tmp/*" --exclude="./run/*" . |
            $T -C "$2" --numeric-owner --xattrs --acls -xpf -
        echo "copy exit $?"; df -h "$2" | tail -1
        umount "$2"; losetup -d /dev/block/loop$n
    ' sh "$IMG" "$R" "$D"
    gnu cp --sparse=always "$IMG" "$CLEAN" && echo "snapshot: $CLEAN"
    ;;
start)
    if alive; then echo "already running: $P"; exit 0; fi
    [ -f "$IMG" ] || { echo "no image: ohm-sandbox create"; exit 1; }
    # Only real conflicts refuse: the demo has its own image, directory and loop device,
    # and without the app nothing in here listens on a socket.
    attached && { echo "refusing: $IMG is attached to a loop already"; exit 1; }
    rm -f "$PIDF"
    nohup unshare -m -p -i -u -f sh "$0" _session < /dev/null > "$S/sandbox.log" 2>&1 &
    i=0; while [ $i -lt 30 ] && ! alive; do sleep 1; i=$((i+1)); done
    alive && echo "started: $P" || { echo "failed to start"; cat "$S/sandbox.log"; exit 1; }
    ;;
_session)
    set -e
    mount --make-rprivate / 2>/dev/null || true
    n=0
    until losetup "/dev/block/loop$n" "$IMG" 2>/dev/null; do
        n=$((n+1)); [ -b "/dev/block/loop$n" ] || { echo "no free loop device"; exit 1; }
    done
    echo "/dev/block/loop$n" > "$S/sandbox.loop"
    # a failure before pivot_root: unmount and free the loop, so start can be retried
    trap 'cd /; umount -l "$R" 2>/dev/null; losetup -d "/dev/block/loop$n" 2>/dev/null; rm -f "$S/sandbox.loop"' EXIT
    mount -t ext4 -o nodev "/dev/block/loop$n" "$R"
    mount -t proc -o nosuid,nodev,noexec proc "$R/proc"
    # the kernel's knobs stay read-only (no sys_admin inside to remount them)
    mount -o bind "$R/proc/sys" "$R/proc/sys"; mount -o remount,bind,ro "$R/proc/sys"
    mount -o bind /dev/null "$R/proc/sysrq-trigger" 2>/dev/null || true
    # sysfs read-only: HongMeng refuses a read-only remount of a bind (ENOTSUP), so a
    # fresh read-only sysfs; without one, /sys stays empty rather than writable
    mount -t sysfs -o ro,nosuid,nodev,noexec sysfs "$R/sys" || echo "no read-only sysfs: /sys left empty"
    mount -t tmpfs -o mode=755,nosuid tmpfs "$R/dev"
    for d in "null 1 3" "zero 1 5" "full 1 7" "random 1 8" "urandom 1 9" "tty 5 0" "ptmx 5 2"; do
        set -- $d; mknod "$R/dev/$1" c "$2" "$3"; chmod 666 "$R/dev/$1"
    done
    mkdir -p "$R/dev/pts" "$R/dev/shm"
    mount -t devpts -o newinstance,ptmxmode=0666 devpts "$R/dev/pts" 2>/dev/null || true
    mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$R/dev/shm"
    if [ -c /dev/system_heap2 ]; then  # the desktop's buffers; numbers differ per machine
        mkdir -p "$R/dev/dma_heap"
        set -- $(stat -c '%t %T' /dev/system_heap2)
        mknod "$R/dev/dma_heap/system" c $((0x$1)) $((0x$2)); chmod 666 "$R/dev/dma_heap/system"
    fi
    ln -sf /proc/self/fd "$R/dev/fd"
    ln -sf /proc/self/fd/0 "$R/dev/stdin"; ln -sf /proc/self/fd/1 "$R/dev/stdout"; ln -sf /proc/self/fd/2 "$R/dev/stderr"
    mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$R/tmp"
    mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$R/run"
    mkdir -p "$R/usr/local/sbin" && cp "$S/bin/ohm-capdrop" "$R$CAPDROP" && chmod 755 "$R$CAPDROP"
    trap - EXIT
    cut -d' ' -f4 /proc/self/stat > "$PIDF"   # host pid of this shell (host procfs still)
    # the image becomes /; the host's filesystem is detached from this namespace
    mkdir -p "$R/.oldroot"
    cd "$R"
    pivot_root . .oldroot
    cd /
    /usr/bin/umount -l /.oldroot
    /usr/bin/rmdir /.oldroot
    set +e
    echo "sandbox up on /dev/block/loop$n"
    exec "$CAPDROP" "$DROP" -- /usr/bin/env -i /usr/bin/catatonit -P
    ;;
run|shell)
    alive || { echo "not running"; exit 1; }
    c=$1; shift
    [ "$c" = shell ] && set -- /usr/bin/bash -l
    # ohm-capdrop joins the namespaces (the mount one last: it moves the process to the
    # image's root), drops the capabilities and runs the command in a child
    exec "$S/bin/ohm-capdrop" --enter "$P" "$DROP" -- /usr/bin/env -i HOME=/root TERM=xterm-256color \
        LANG=C.UTF-8 PATH=/usr/local/sbin:/usr/local/bin:/usr/bin "$@"
    ;;
status)
    alive && echo "running: $P ($(cat "$S/sandbox.loop" 2>/dev/null))" || echo "stopped"
    ;;
build-helpers)
    alive || { echo "not running"; exit 1; }
    # sources go in on stdin; nothing of the host is mounted inside
    tar -C "$S/src" -cf - ohime.c ohmarchy-audio-relay.c ohmarchy-desktop input-method-unstable-v2.xml \
        hongmeng-ptypeer.c |
        sh "$0" run /usr/bin/bash -c '
set -e; d=/root/ohm-src; rm -rf $d; mkdir -p $d; tar -C $d -xf -; cd $d
wayland-scanner client-header input-method-unstable-v2.xml input-method-unstable-v2-client-protocol.h
wayland-scanner private-code input-method-unstable-v2.xml input-method-unstable-v2-protocol.c
gcc -O2 -o /opt/ohmarchy/bin/ohime ohime.c input-method-unstable-v2-protocol.c -I. -lwayland-client
cc -O2 -o /opt/ohmarchy/bin/ohmarchy-audio-relay ohmarchy-audio-relay.c
install -m 755 ohmarchy-desktop /opt/ohmarchy/bin/ohmarchy-desktop
# ptys: no slave nodes in here (the host keeps them); open the slave through the master
gcc -O2 -shared -fPIC -o /usr/local/lib/libhongmeng-ptypeer.so hongmeng-ptypeer.c -ldl
grep -q libhongmeng-ptypeer /etc/ld.so.preload || echo /usr/local/lib/libhongmeng-ptypeer.so >> /etc/ld.so.preload
echo "helpers built"'
    ;;
desktop)
    c=${2:-start}
    if [ "$c" = restart ]; then sh "$0" desktop stop > /dev/null 2>&1; exec sh "$0" desktop start; fi
    if [ "$c" = status ]; then
        alive && sh "$0" run /usr/bin/pgrep -x Hyprland > /dev/null && echo running || echo stopped
        exit 0
    fi
    if [ "$c" = start ]; then sh "$0" start > /dev/null || exit 1; fi
    alive || { echo "not running"; exit 1; }
    pw=$(grep "^$USER_:" "/proc/$P/root/etc/passwd") || { echo "no user $USER_"; exit 1; }
    uid=$(echo "$pw" | cut -d: -f3); gid=$(echo "$pw" | cut -d: -f4); home=$(echo "$pw" | cut -d: -f6)
    app_uid=$(bm dump -n "$APP" 2>/dev/null | grep -m1 '"uid"' | tr -dc 0-9)
    if [ "$c" = start ]; then
        sh "$0" run /opt/ohmarchy/bin/ohmarchy-sysbus start > /dev/null 2>&1
        # The GPU broker belongs to the helper: it runs on the host, binds the desktop's
        # vtest socket into the sandbox through /proc/<init>/root, hands the desktop's
        # GPU connections to the app (only $APP's uid), and restarts the desktop when
        # the app connects. Its pid is ours to stop.
        sock=/proc/$P/root/tmp/.virgl_test
        if ! { [ -f "$S/broker.pid" ] && kill -0 "$(cat "$S/broker.pid")" 2>/dev/null; }; then
            rm -f "$sock"
            setsid "$S/bin/vtest-broker" --on-app "sh $0 desktop restart" ${app_uid:+--app-uid "$app_uid"} \
                --user "$uid:$gid" "$sock" "$PREFIX-vtest" < /dev/null > "$S/broker.log" 2>&1 &
            echo $! > "$S/broker.pid"
            i=0; while [ $i -lt 30 ] && [ ! -S "$sock" ]; do sleep 0.1; i=$((i+1)); done
            chmod 666 "$sock"
        fi
    fi
    # the desktop runs as the user, with the sandbox's socket names
    exec "$S/bin/ohm-capdrop" --enter "$P" "$DROP" -- /usr/bin/env -i HOME="$home" USER="$USER_" \
        LOGNAME="$USER_" SHELL=/bin/bash LANG=en_US.UTF-8 XDG_RUNTIME_DIR="/run/user/$uid" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/bin OHMARCHY_SOCKET_PREFIX="$PREFIX" \
        ${app_uid:+OHMARCHY_APP_UID="$app_uid"} HYPRLAND_SURFACELESS_GALLIUM_DRIVER=virpipe \
        HYPRLAND_READBACK_PRESENT=1 /usr/bin/bash -c '
install -d -m 700 -o "$1" -g "$2" "$XDG_RUNTIME_DIR"
cd "$HOME" 2>/dev/null || cd /
exec /usr/bin/chroot --skip-chdir --userspec="$1:$2" --groups="$(id -G "$3" | tr " " ,)" / \
    /usr/bin/bash -lc "/opt/ohmarchy/bin/ohmarchy-desktop $4"' ohm "$uid" "$gid" "$USER_" "$c"
    ;;
stop)
    alive || { echo "not running"; exit 0; }
    # the broker forks a child per role: end every process running our broker binary
    # (the demo's runs from its own directory, so it is never matched)
    for d in /proc/[0-9]*; do
        [ "$(readlink "$d/exe" 2>/dev/null)" = "$S/bin/vtest-broker" ] && kill "${d#/proc/}" 2>/dev/null
    done
    rm -f "$S/broker.pid"
    nsenter -t "$P" -m sync
    kill -9 "$P"   # pid-namespace init: SIGKILL tears the namespace down
    i=0; while [ $i -lt 20 ] && [ -d "/proc/$P" ]; do sleep 1; i=$((i+1)); done
    rm -f "$PIDF"
    L=$(cat "$S/sandbox.loop" 2>/dev/null)
    i=0
    while [ -n "$L" ] && [ $i -lt 20 ] && losetup "$L" 2>/dev/null | grep -qF "($IMG)"; do
        losetup -d "$L" 2>/dev/null || sleep 0.5
        i=$((i+1))
    done
    rm -f "$S/sandbox.loop"
    echo stopped
    ;;
reset)
    alive && { echo "running: stop it first"; exit 1; }
    [ -f "$CLEAN" ] || { echo "no snapshot $CLEAN"; exit 1; }
    # the copy needs the snapshot's used size (~14 GB) free; keep a wide margin
    free=$(df -k "$S" | awk 'NR==2 {print int($4 / 1048576)}')
    [ "$free" -ge 50 ] || { echo "refusing: only ${free} GB free on $(df "$S" | awk 'NR==2 {print $6}')"; exit 1; }
    # low priority, so a running demo desktop is not slowed down
    lo="nice -n 19"; command -v ionice > /dev/null && lo="$lo ionice -c 3"
    $lo sh "$0" _copy "$CLEAN" "$IMG.new" && mv "$IMG.new" "$IMG" && echo "reset to the snapshot"
    ;;
_copy)
    gnu cp --sparse=always "$2" "$3"
    ;;
*)
    echo "usage: ohm-sandbox create|start|stop|status|reset|run CMD..|shell" >&2; exit 2 ;;
esac
