 }
 
+struct ns_call_args {
+	int (*fn)(void *);
+	void *arg;
+};
+
+static void *ns_call_thread(void *p)
+{
+	struct ns_call_args *a = p;
+
+	a->fn(a->arg);
+	return NULL;
+}
+
+/**
+ * ns_call() - Run @fn in a thread of its own, wait for it
+ * @fn:		Function, may setns() (affects only that thread)
+ * @arg:	Argument to @fn
+ *
+ * #syscalls clone clone3 futex mmap mprotect munmap madvise set_robust_list
+ * #syscalls rseq rt_sigprocmask exit
+ */
+void ns_call(int (*fn)(void *), void *arg)
+{
+	struct ns_call_args a = { fn, arg };
+	pthread_t t;
+
+	if (pthread_create(&t, NULL, ns_call_thread, &a))
+		die("Couldn't start a thread to enter the namespace");
+	pthread_join(t, NULL);
+}
