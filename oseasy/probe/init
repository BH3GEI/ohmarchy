#!/bin/busybox sh
# Oseasy VM boot probe (initramfs /init). Reports to the serial port, which
# StratoVirt writes to /data/log/hwf_service/vmlog on the host, and to tty0.
/bin/busybox --install -s /bin
# kmod, not busybox, for module loading (busybox ignores updates/ and .ko.zst deps)
rm -f /bin/modprobe /bin/insmod /bin/rmmod /bin/lsmod /bin/depmod /bin/modinfo
export PATH=/usr/bin:/bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
echo /usr/bin/modprobe > /proc/sys/kernel/modprobe
# module options from the kernel command line (vmwgfx.x=y), for kmod
mkdir -p /etc/modprobe.d
for a in $(cat /proc/cmdline); do
    case $a in (vmwgfx.*=*) o=${a#vmwgfx.}; echo "options vmwgfx $o" >> /etc/modprobe.d/cmdline.conf ;; esac
done
mkdir -p /dev/pts; mount -t devpts devpts /dev/pts
log() { echo "[probe] $*" > /dev/ttyAMA0 2>/dev/null; echo "[probe] $*" > /dev/tty0 2>/dev/null; }
cmd=$(cat /proc/cmdline)
log "up: $(uname -r)"
log "cmdline: $cmd"
for d in /sys/bus/pci/devices/*; do
    log "pci $(basename $d) $(cat $d/vendor):$(cat $d/device) class $(cat $d/class)"
done

# network: the HarmonyOS side of the bridge is 172.16.100.1, no DHCP
modprobe virtio_net 2>/dev/null
i=0; while [ $i -lt 20 ] && ! ls /sys/class/net | grep -qv '^lo$'; do sleep 0.5; i=$((i+1)); done
IF=$(ls /sys/class/net | grep -v '^lo$' | head -1)
ip link set lo up
if [ -n "$IF" ]; then
    ip link set "$IF" up
    ip addr add 172.16.100.2/24 dev "$IF"
    ip route add default via 172.16.100.1
    telnetd -p 5000 -l /bin/sh
    log "net: $IF 172.16.100.2/24, telnet root shell on port 5000"
else
    log "net: no interface"
fi

case " $cmd " in
*" probe.install=1 "*)
    # Get a zstd-compressed raw disk image and write it to /dev/vda, all without a
    # host or root. Look for omarchy-pure.img.zst in three places, in order:
    #   1. embedded in this boot ISO (the same ISO Oseasy attaches as a CD) -- one
    #      download, but makes the ISO image-sized;
    #   2. Oseasy's virtiofs share (tag shared_dir = HarmonyOS 文件管理器/Documents):
    #      the user drops the image there with the file manager, ISO stays small;
    #   3. a host push on tcp/5003 (oseasy/push-disk.sh), for development.
    modprobe virtio_blk 2>/dev/null
    for m in usb_storage uas sr_mod isofs virtiofs; do modprobe "$m" 2>/dev/null; done
    sleep 1
    imgzst=
    i=0; while [ $i -lt 10 ] && [ -z "$imgzst" ]; do
        for cd in /dev/sr0 /dev/sr1 /dev/cdrom; do
            [ -b "$cd" ] || continue
            mkdir -p /cdrom
            mount -t iso9660 -o ro "$cd" /cdrom 2>/dev/null || continue
            [ -f /cdrom/omarchy-pure.img.zst ] && { imgzst=/cdrom/omarchy-pure.img.zst; break; }
            umount /cdrom 2>/dev/null
        done
        [ -z "$imgzst" ] && { sleep 1; i=$((i+1)); }
    done
    if [ -z "$imgzst" ]; then
        mkdir -p /shared
        if mount -t virtiofs shared_dir /shared 2>/dev/null; then
            for f in /shared/omarchy-pure.img.zst /shared/Download/omarchy-pure.img.zst; do
                [ -f "$f" ] && { imgzst=$f; break; }
            done
            [ -n "$imgzst" ] && log "install: found image on the shared folder: $imgzst"
        fi
    fi
    if [ -n "$imgzst" ]; then
        log "install: writing /dev/vda from $imgzst (embedded in the ISO)"
        zstd -dc "$imgzst" | /usr/bin/dd of=/dev/vda bs=4M iflag=fullblock conv=sparse,fsync 2> /tmp/dd.txt
    else
        log "install: no image on CD or shared folder; waiting for one on tcp/5003, writing /dev/vda"
        # busybox nc -l does not exit when the sender closes (and -w also bounds the wait
        # for the connection): a watchdog ends it once dd has seen no input for 20 s
        ( last=-1; while sleep 10; do
            p=$(pidof dd); [ -n "$p" ] || continue
            n=$(awk '/^rchar/ {print $2}' /proc/$p/io 2>/dev/null)
            [ "$n" = "$last" ] && [ "${n:-0}" -gt 0 ] && { kill $(pidof nc) 2>/dev/null; break; }
            last=$n
          done ) &
        nc -l -p 5003 | zstd -dc | /usr/bin/dd of=/dev/vda bs=4M iflag=fullblock conv=sparse,fsync 2> /tmp/dd.txt
    fi
    log "install: dd: $(tail -1 /tmp/dd.txt)"
    blockdev --rereadpt /dev/vda; sleep 2
    root=$(ls /dev/vda2 2>/dev/null)
    mkdir -p /mnt
    if [ -n "$root" ] && mount -t ext4 "$root" /mnt; then
        kv=$(ls /mnt/usr/lib/modules | grep -e "^$(uname -r)$" | head -1)
        [ -n "$kv" ] || kv=$(ls /mnt/usr/lib/modules | head -1)
        install -D -m644 /oseasy/vmwgfx.ko "/mnt/usr/lib/modules/$kv/updates/vmwgfx.ko"
        install -D -m644 /oseasy/vmwgfx-oseasy.conf /mnt/etc/modprobe.d/vmwgfx-oseasy.conf
        # depmod and mkinitcpio run inside the target so its depmod.d (search
        # updates first) applies; mkinitcpio's kms hook would otherwise carry the
        # in-tree vmwgfx, which loads before the root and crashes on this device.
        # mkinitcpio wants real proc/sys/dev mounts and /dev/fd.
        mount -t proc proc /mnt/proc; mount -t sysfs sys /mnt/sys; mount -t devtmpfs dev /mnt/dev
        ln -sf /proc/self/fd /mnt/dev/fd; ln -sf /proc/self/fd/0 /mnt/dev/stdin
        ln -sf /proc/self/fd/1 /mnt/dev/stdout; ln -sf /proc/self/fd/2 /mnt/dev/stderr
        chroot /mnt /usr/bin/depmod -a "$kv"
        log "install: vmwgfx-oseasy added for $kv; modinfo -> $(chroot /mnt /usr/bin/modinfo -k "$kv" -n vmwgfx)"
        chroot /mnt /usr/bin/mkinitcpio -P > /tmp/mkinitcpio.txt 2>&1; mkrc=$?
        log "install: mkinitcpio rc=$mkrc; initramfs vmwgfx: $(chroot /mnt /usr/bin/lsinitcpio /boot/initramfs-linux.img | grep vmwgfx | tr '\n' ' ')"
        # boot straight into Hyprland (tty1 autologin + uwsm; SDDM's greeter exits here)
        u=$(awk -F: '$3 == 1000 {print $1}' /mnt/etc/passwd)
        [ -n "$u" ] && chroot /mnt /bin/bash /dev/stdin "$u" < /oseasy/desktop-autostart.sh > /tmp/autostart.txt 2>&1
        log "install: desktop autostart for ${u:-?}: $(tail -1 /tmp/autostart.txt)"
        # obsidian (Electron) falls back to X11 and exits when started without the
        # session's ELECTRON_OZONE_PLATFORM_HINT; pin Wayland in its launcher
        d=/mnt/usr/share/applications/obsidian.desktop
        if [ -f "$d" ]; then
            mkdir -p /mnt/usr/local/share/applications
            sed 's|^\(Exec=[^ ]*\)|\1 --ozone-platform=wayland|' "$d" > /mnt/usr/local/share/applications/obsidian.desktop
            log "install: obsidian launcher: $(grep -m1 '^Exec=' /mnt/usr/local/share/applications/obsidian.desktop)"
        fi
        # Hyprland diagnostics (oseasy/guest/boot-diag.sh): installed, enabled only
        # with probe.diag=1 on the install's command line (it restarts the session
        # with tracing for its first minutes, which spoils measurements)
        install -D -m755 /oseasy/boot-diag.sh /mnt/usr/local/bin/ohmarchy-boot-diag
        install -D -m644 /oseasy/ohmarchy-boot-diag.service /mnt/etc/systemd/system/ohmarchy-boot-diag.service
        case " $cmd " in *" probe.diag=1 "*)
            ln -sf /etc/systemd/system/ohmarchy-boot-diag.service /mnt/etc/systemd/system/multi-user.target.wants/ohmarchy-boot-diag.service
            log "install: boot diagnostics enabled" ;;
        *) log "install: boot diagnostics installed, not enabled" ;;
        esac
        # Persist the user's files across reinstalls on Oseasy's shared folder.
        # Oseasy exports a virtiofs device (tag "shared_dir") backed by the host's
        # 文件管理器/Documents. A 再次安装 wipes /dev/vda, so keep user data off the
        # disk: mount the share at ~/Shared and point ~/Documents at it. nofail +
        # a short device timeout so the system still boots if the share is absent.
        if [ -n "$u" ]; then
            uh=/mnt/home/$u
            install -d -m755 "$uh/Shared"; chroot /mnt chown "$u:$u" "/home/$u/Shared" 2>/dev/null
            grep -q '[[:space:]]/home/'"$u"'/Shared[[:space:]]' /mnt/etc/fstab 2>/dev/null || \
                printf 'shared_dir\t/home/%s/Shared\tvirtiofs\tnofail\t0 0\n' "$u" >> /mnt/etc/fstab
            if [ -d "$uh/Documents" ] && [ ! -L "$uh/Documents" ]; then
                cp -a "$uh/Documents/." "$uh/Shared/" 2>/dev/null || true
                rm -rf "$uh/Documents"
            fi
            chroot /mnt sh -c "cd /home/$u && ln -sfn Shared Documents" 2>/dev/null
            log "install: shared folder /home/$u/Shared (virtiofs shared_dir); Documents -> Shared"
        fi
        # Mark a fully-installed disk, on the ext4 root so GRUB's search finds it.
        # The default GRUB entry boots a marked disk directly instead of installing.
        # Note: Oseasy's 再次安装 WIPES /dev/vda before this ISO boots, so the marker
        # is gone by then and that path always reinstalls; the marker matters for the
        # post-install auto-reboot below, which boots the just-written disk. Only on a
        # clean mkinitcpio, so a broken install reinstalls next boot.
        if [ "$mkrc" = 0 ]; then
            printf 'ohmarchy-oseasy\ninstalled=%s\nkver=%s\n' \
                "$(date -u +%FT%TZ)" "$kv" > /mnt/boot/ohmarchy-oseasy-installed
            log "install: marked /boot/ohmarchy-oseasy-installed; next boot runs from vda"
        else
            log "install: mkinitcpio failed (rc=$mkrc); not marking, will reinstall next boot"
        fi
        umount /mnt/dev /mnt/sys /mnt/proc
        umount /mnt
    else
        log "install: could not mount the root partition"
    fi
    sync
    log "install: INSTALL_DONE"
    # On a good install, reboot straight into it: this ISO boots again (Oseasy keeps
    # it attached), the default GRUB entry finds the marker and boots /dev/vda, so a
    # single "再次安装" tap ends at the desktop with no further interaction. A guest
    # reboot does not wipe the disk (only Oseasy's 再次安装 does), so the fresh
    # install survives it. probe.noreboot=1 stays at the shell for debugging.
    if [ "${mkrc:-1}" = 0 ]; then
        case " $cmd " in
        *" probe.noreboot=1 "*) log "install: probe.noreboot set; staying at the shell" ;;
        *) log "install: rebooting into the installed system"
           sync; sleep 1
           echo 1 > /proc/sys/kernel/sysrq 2>/dev/null
           echo b > /proc/sysrq-trigger 2>/dev/null
           reboot -f 2>/dev/null ;;
        esac
    fi
    ;;
*" probe.vmwgfx=1 "*)
    # vmwgfx may already be loaded without options by an early autoload: reload
    # it with the vmwgfx.* options from the kernel command line
    opts=$(for a in $cmd; do case $a in (vmwgfx.*=*) printf '%s ' "${a#vmwgfx.}" ;; esac; done)
    log "loading vmwgfx $opts"
    modprobe -r vmwgfx 2>/dev/null
    modprobe vmwgfx $opts; log "modprobe vmwgfx rc=$?"
    sleep 2
    dmesg | grep -i -e vmwgfx -e '\[drm' | while read -r l; do log "$l"; done
    if [ -e /dev/dri/card0 ]; then
        modetest -M vmwgfx -c > /tmp/connectors.txt 2>&1
        conn=$(awk '/\tconnected\t/{print $1; exit}' /tmp/connectors.txt)
        mode=$(awk '/\tconnected\t/{f=1; next} f && /^  #0 /{print $2; exit}' /tmp/connectors.txt)
        log "connector $conn mode $mode"
        grep -A3 '^  #0 ' /tmp/connectors.txt | while read -r l; do log "mode: $l"; done
        # GPU rendering on KMS for 20 s (fps, renderer, centre pixel)
        if [ -x /usr/bin/kmsgl ]; then
            timeout 25 kmsgl 20 > /tmp/kmsgl.txt 2>&1
            while read -r l; do log "$l"; done < /tmp/kmsgl.txt
        fi
        # test pattern with page flips for 30 s; modetest prints the flip rate
        timeout 30 modetest -M vmwgfx -s "$conn:$mode" -v > /tmp/modetest.txt 2>&1
        grep -i -e freq -e fail -e error /tmp/modetest.txt | tail -5 | while read -r l; do log "modetest: $l"; done
        dmesg | grep -i -e vmwgfx -e '\[drm' | tail -20 | while read -r l; do log "after: $l"; done
    fi
    ;;
esac
log "ready; shell on tty0 and telnet 172.16.100.2:5000"
setsid cttyhack sh -c 'exec sh </dev/tty0 >/dev/tty0 2>&1' &
while :; do sleep 3600; done
