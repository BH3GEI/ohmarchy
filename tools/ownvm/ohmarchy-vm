#!/system/bin/sh
# ohmarchy-vm: route I as a service, a headless Omarchy VM that is the
# background Linux kernel for route D's desktop (Docker and anything else that
# needs a full kernel). Root on the HarmonyOS host. docs/vm-own.md.
#   ohmarchy-vm start      start the VM (idempotent: does nothing if running)
#   ohmarchy-vm stop       power off from inside the guest, QMP/kill as fallback
#   ohmarchy-vm status     VM, guest ssh, dockerd, balloon
#   ohmarchy-vm running    exit 0 if the VM runs (quick, no output)
#   ohmarchy-vm ssh [CMD]  ssh into the guest as yao (host-only key)
#   ohmarchy-vm balloon MiB   set the guest's memory target (QMP balloon)
#   ohmarchy-vm net-up | net-down   only the host network part (idempotent)
# No locks: start refuses only when another StratoVirt VM already runs.
#
# Settings (environment, or $OVM_DIR/config sourced as shell):
#   OVM_DIR   run files, disk and key        (/data/local/kaidashi/ownvm)
#   OVM_DISK  raw disk image                 ($OVM_DIR/omarchy-own.img)
#   OVM_CPUS  vCPUs (6)   OVM_MEM  MiB (12288)   OVM_GPU=1  virgl GPU (off)
#   OVM_SHARE=0  no home share (default: share D's /home/builder, see below)
#   OVM_VIRTIOFSD  upstream (default): /data/local/kaidashi/bin/virtiofsd-upstream,
#             a static build of upstream 1.14.0 (tools/ownvm/build-virtiofsd.sh);
#             system: HarmonyOS's own build, which forces 0660/0771 on every file
#
# Home share: route D's terminal runs as builder (uid/gid 60000) in the
# archtest session, so D's /home/builder (on the host only as
# /proc/<session>/root/home/builder) is shared with virtiofsd (tag
# "builder") and mounted at the same path in the guest. `docker run -v $PWD:…`
# from D's terminal then finds $PWD in the VM. Ownership: host 60000 shows as
# the guest's yao (1000), and every guest uid/gid writes as 60000 on the host,
# so files that containers create as root still belong to builder in D.
#
# Network: tap ohmvm0 with 172.16.100.1/24, the guest is 172.16.100.2 (static
# in the image), outbound NAT. The host's policy routing would send the subnet
# out wlan0 (rule 16000: fwmark 0 -> table 2009) and forwarded guest packets
# find no default route in main, so two rules: to the subnet -> main (10500),
# from the tap -> table 2009 (10501). 鸿融 uses the same subnet on its own
# bridge, so this refuses to start while any other StratoVirt runs.
OVM_DIR=${OVM_DIR:-/data/local/kaidashi/ownvm}
[ -r $OVM_DIR/config ] && . $OVM_DIR/config
DISK=${OVM_DISK:-$OVM_DIR/omarchy-own.img}
CPUS=${OVM_CPUS:-6}; MEM=${OVM_MEM:-12288}
D=$OVM_DIR/svc
TAP=ohmvm0; NET=172.16.100; GUEST=$NET.2
FW=/system/opt/virt_service/virtualized_hwf/stratovirt-uefi-linux
SVDIR=/system/bin/virt_service/vm_engine/stratovirt
pidf=$D/stratovirt.pid
# ours only: the recorded pid, still a StratoVirt on our disk (never by name)
# (HongMeng's grep does not match inside the NUL-separated cmdline: tr first)
# On HongMeng reading /proc/<pid>/cmdline of a process that is exiting can block
# for good, even after the process is gone (2026-10-27: VM pid 35045, the idle
# stop hung in running() and the docker gate with it), and such a read may not
# even die on SIGKILL, so nothing may wait for it: procread runs the read in the
# background into a file, waits at most 3 s and otherwise leaves it behind.
# kill -0 first: a process that is gone is not read at all.
procread() {  # PID FILE(stat|cmdline|status)
  kill -0 $1 2>/dev/null || return 1
  local o=$D/.procread.$$ i=0
  rm -f $o $o.ok
  ( tr '\0' ' ' < /proc/$1/$2 > $o 2>/dev/null && : > $o.ok ) < /dev/null > /dev/null 2>&1 &
  while [ ! -f $o.ok ] && [ $i -lt 6 ]; do sleep 0.5; i=$((i+1)); done
  [ -f $o.ok ] && cat $o; local r=$?; rm -f $o $o.ok; return $r
}
# exiting (Z/X) or unreadable counts as gone
cmdline() {
  case $(procread $1 stat | awk '{print $3}') in
  ''|Z|X) return 1 ;;
  esac
  procread $1 cmdline
}
# (into a variable: a pipe into grep -q would kill procread before it cleans up)
running() {
  [ -f $pidf ] || return 1
  local c; c=$(cmdline $(cat $pidf)) || return 1
  case "$c" in *"$DISK"*) return 0 ;; esac
  return 1
}
# ssh comes from route D's Arch root (archtest) until the host has its own
AR=/proc/$(cat /data/local/archtest/session.pid 2>/dev/null)/root
SSH() {
  "$AR/usr/lib/ld-linux-aarch64.so.1" --library-path "$AR/usr/lib" "$AR/usr/bin/ssh" \
    -i $OVM_DIR/hostkey -o UserKnownHostsFile=$OVM_DIR/known_hosts -o StrictHostKeyChecking=yes \
    -o LogLevel=ERROR -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 -o BatchMode=yes yao@$GUEST "$@"
}
qmp() {  # one command per write: StratoVirt's parser takes one JSON object at a time
  { sleep 0.5; echo '{"execute":"qmp_capabilities"}'; sleep 0.5; echo "$1"; sleep 1; } |
    timeout 5 toybox nc -U $D/qmp.sock 2>/dev/null | tail -1
}
rule() {  # rule PREF ARGS...: add once
  ip rule show pref $1 | grep -q . || { p=$1; shift; ip rule add "$@" pref $p; }
}

net_up() {
  ip link show $TAP >/dev/null 2>&1 || ip tuntap add dev $TAP mode tap
  ip addr show dev $TAP | grep -q "$NET.1/24" || ip addr add $NET.1/24 dev $TAP
  ip link set $TAP up
  iptables -t nat -C POSTROUTING -s $NET.0/24 ! -o $TAP -j MASQUERADE 2>/dev/null ||
    iptables -t nat -A POSTROUTING -s $NET.0/24 ! -o $TAP -j MASQUERADE
  rule 10500 to $NET.0/24 lookup main
  rule 10501 iif $TAP lookup 2009
  echo 1 > /proc/sys/net/ipv4/ip_forward
}
net_down() {
  while ip rule show pref 10500 | grep -q .; do ip rule del pref 10500; done
  while ip rule show pref 10501 | grep -q .; do ip rule del pref 10501; done
  while iptables -t nat -D POSTROUTING -s $NET.0/24 ! -o $TAP -j MASQUERADE 2>/dev/null; do :; done
  ip link del $TAP 2>/dev/null
  return 0
}

start() {
  running && { echo "running, pid $(cat $pidf)"; return 0; }
  pidof stratovirt >/dev/null && { echo "another StratoVirt VM runs (鸿融?); not starting"; return 1; }
  mkdir -p $D; rm -f $D/qmp.sock $D/serial.sock
  net_up
  gpu=
  if [ "${OVM_GPU:-0}" = 1 ]; then
    rm -f $D/gpu.sock
    VHOST_LOG_PATH=$D/vhost-device-gpu.log nohup $SVDIR/vhost-device-gpu \
      --socket-path $D/gpu.sock --gpu-mode virglrenderer --use-gles false > $D/vhost-device-gpu.out 2>&1 &
    echo $! > $D/vhost-device-gpu.pid
    i=0; while [ ! -S $D/gpu.sock ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
    gpu="-chardev socket,id=vhost-user-gpu,path=$D/gpu.sock
      -device vhost-user-gpu-pci,id=vhost-user-gpu-id,bus=pcie.0,addr=0x4.0x0,xres=2160,yres=1440,chardev=vhost-user-gpu,virgl=true"
  fi
  fs=
  BH=$AR/home/builder; MB=$OVM_DIR/home-builder; FD=$D/fs
  if [ "${OVM_SHARE:-1}" = 1 ] && [ -d "$BH" ]; then
    # virtiofsd runs as builder (60000), not root, so that even an escape from
    # the share (there is no chroot: HongMeng refuses virtiofsd's chroot and
    # namespace sandboxes) reaches only builder's own files. As 60000 it cannot
    # open /proc/<root pid>/root, hence the bind mount to a plain host path;
    # dropuid (tools/ownvm/dropuid.c) switches uid/gid, which clears all
    # capabilities; util-linux setpriv cannot (HongMeng refuses PR_SET_KEEPCAPS).
    mkdir -p $MB $FD; chown 60000:60000 $FD; rm -f $FD/*.sock
    grep -q " $MB " /proc/self/mountinfo || mount --bind "$BH" $MB
    # --passthrough-fs (HarmonyOS's build): without it the default
    # "virtual_fs" mode answers OPENDIR/MKDIR with ENODEV.
    # a copy of the system virtiofsd: uid 60000 may not execute the one under
    # /system (exec gives EACCES although the mode is 755)
    # plain cp: -p keeps the system file's security label, and exec fails again
    # refreshed whenever the system binary changes (a system update)
    if ! cmp -s $SVDIR/virtiofsd /data/local/kaidashi/bin/virtiofsd; then
      cp $SVDIR/virtiofsd /data/local/kaidashi/bin/virtiofsd.new &&
        chmod 755 /data/local/kaidashi/bin/virtiofsd.new &&
        mv /data/local/kaidashi/bin/virtiofsd.new /data/local/kaidashi/bin/virtiofsd
    fi
    run_as="/data/local/kaidashi/bin/dropuid 60000 60000"
    [ "${OVM_FS_ROOT:-0}" = 1 ] && run_as=   # diagnostic: virtiofsd as root
    ids="--translate-uid host:60000:1000:1 --translate-uid squash-guest:0:60000:4294967295
      --translate-gid host:60000:1000:1 --translate-gid squash-guest:0:60000:4294967295"
    if [ "${OVM_VIRTIOFSD:-upstream}" = upstream ]; then
      # upstream has no --cmd-socket-path, --passthrough-fs or --log-file
      # (HarmonyOS additions): its log goes to stderr, i.e. virtiofsd.out
      $run_as /data/local/kaidashi/bin/virtiofsd-upstream --shared-dir $MB --socket-path $FD/fs.sock \
        --tag builder --sandbox none --seccomp none --rlimit-nofile 0 --cache auto --announce-submounts \
        ${OVM_FS_EXTRA:-} $ids > $D/virtiofsd.out 2>&1 &
    else
    $run_as /data/local/kaidashi/bin/virtiofsd --shared-dir $MB --socket-path $FD/fs.sock \
      --cmd-socket-path $FD/fs-cmd.sock --tag builder \
      --sandbox none --seccomp none --rlimit-nofile 0 --cache auto --announce-submounts --passthrough-fs ${OVM_FS_EXTRA:-} \
      $ids --log-file $FD/virtiofsd.log > $D/virtiofsd.out 2>&1 &
    fi
    echo $! > $D/virtiofsd.pid
    i=0; while [ ! -S $FD/fs.sock ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
    if [ -S $FD/fs.sock ]; then
      fs="-chardev socket,id=fsd_sock,path=$FD/fs.sock
        -device vhost-user-fs-pci,id=fsd_dev,chardev=fsd_sock,tag=builder,bus=pcie.0,addr=0x8"
      echo "home share: virtiofsd pid $(cat $D/virtiofsd.pid), uid $(awk '/^Uid/{print $2}' /proc/$(cat $D/virtiofsd.pid)/status 2>/dev/null)"
    else
      echo "virtiofsd did not start (home share off):"; tail -5 $D/virtiofsd.out
    fi
  fi
  nohup $SVDIR/stratovirt \
    -machine virt,gic-version=3,mem-share=on,accel=hmv \
    -cpu host,pmu=on,kvm-steal-time=on,bti=off -smp $CPUS -m $MEM \
    -drive file=$FW,if=pflash,unit=0,readonly=true \
    -drive id=disk0,file=$DISK,format=raw,readonly=off,direct=on,aio=io_uring \
    -device virtio-blk-pci,drive=disk0,id=blk0,bus=pcie.0,addr=0x2.0x0 \
    -netdev tap,id=net0,ifname=$TAP \
    -object iothread,id=rx-iothread0 -object iothread,id=tx-iothread0 \
    -device virtio-net-pci,netdev=net0,id=nic0,bus=pcie.0,mac=52:54:00:4d:76:01,addr=0x6.0x0,rx-iothread=rx-iothread0,tx-iothread=tx-iothread0 \
    -device virtio-balloon-pci,id=balloon0,bus=pcie.0,addr=0x7.0x0,deflate-on-oom=true,free-page-reporting=true \
    $gpu $fs \
    -device ohos-vhost-vsock-pci,guest-cid=2001,id=vsock0,bus=pcie.0,addr=0xf \
    -qmp unix:$D/qmp.sock,server,nowait \
    -serial socket,path=$D/serial.sock,server,nowait \
    -D $D/stratovirt.log -disable-seccomp > $D/stdout.log 2>&1 &
  echo $! > $pidf; sleep 2
  running || { echo "StratoVirt exited:"; tail -20 $D/stdout.log; stop_rest; return 1; }
  echo "started pid $(cat $pidf); waiting for the guest"
  i=0; while [ $i -lt 180 ]; do SSH true 2>/dev/null && { echo "guest up after ${i}s"; return 0; }; sleep 5; i=$((i+5)); done
  echo "guest ssh not up after 180 s (serial: toybox nc -U $D/serial.sock)"
}

stop_rest() {
  # only PIDs this script recorded, and only if they are still ours
  for f in vhost-device-gpu virtiofsd; do
    if [ -f $D/$f.pid ]; then
      p=$(cat $D/$f.pid)
      cmdline $p | grep -q "$OVM_DIR" && kill $p
      rm -f $D/$f.pid
    fi
  done
  grep -q " $OVM_DIR/home-builder " /proc/self/mountinfo && umount $OVM_DIR/home-builder
  net_down
  return 0
}
stop() {
  if running; then
    # the guest's sudoers allows yao exactly this (guest-provision.sh)
    SSH 'sudo -n /usr/bin/systemctl poweroff' < /dev/null >/dev/null 2>&1
    i=0; while running && [ $i -lt 60 ]; do sleep 2; i=$((i+2)); done
    running && { qmp '{"execute":"system_powerdown"}' >/dev/null; sleep 20; }
    running && { echo "no clean power-off; killing"; kill $(cat $pidf); sleep 2; }
    running && kill -9 $(cat $pidf)
    echo "stopped"
  else
    echo "not running"
  fi
  stop_rest
}

status() {
  if running; then
    echo "VM: pid $(cat $pidf), ${CPUS} vCPUs, ${MEM} MiB"
  else
    echo "VM: not running"; return 3
  fi
  if SSH true 2>/dev/null; then
    echo "guest: $(SSH 'uname -r; uptime -p' 2>/dev/null | tr '\n' ' ')"
    echo "dockerd: $(SSH 'docker info --format "{{.ServerVersion}}, {{.Containers}} containers ({{.ContainersRunning}} running)" | cat' 2>/dev/null || echo unreachable)"
    echo "home share: $(SSH 'findmnt -n -o SOURCE,FSTYPE /home/builder' 2>/dev/null || echo none)"
    echo "guest memory: $(SSH "free -m | awk '/^Mem/{print \$3\" MiB used, \"\$7\" MiB available of \"\$2}'" 2>/dev/null)"
  else
    echo "guest: no ssh"
  fi
  echo "balloon: $(qmp '{"execute":"query-balloon"}')"
  echo "host RSS of the VM: $(procread $(cat $pidf) status | awk '/VmRSS/{print $2/1024 " MiB"}')"
}

case "$1" in
start) start ;;
stop) stop ;;
status) status ;;
running) running ;;
ssh) shift; SSH "$@" ;;
balloon) qmp "{\"execute\":\"balloon\",\"arguments\":{\"value\":$((${2:?MiB} * 1048576))}}" ;;
net-up) net_up ;;
net-down) net_down ;;
*) sed -n '2,12p' "$0"; exit 1 ;;
esac
